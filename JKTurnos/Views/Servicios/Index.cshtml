@model List<JKTurnos.Models.Entities.Servicio>

@helper ListContent() {
    <div class="jk-hide-mobile">
        <div class="jk-table-wrap">
            <table class="jk-table">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Duracion</th>
                        <th class="jk-hide-tablet">Precio</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Nombre</td>
                            <td>@item.DuracionMinutos min</td>
                            <td class="jk-hide-tablet">$ @item.Precio.ToString("N2")</td>
                            <td>
                                @Html.Partial("~/Views/Shared/Components/_TableActions.cshtml",
                                    new ViewDataDictionary {
                                        { "EditUrl", Url.Action("Edit", new { id = item.Id }) },
                                        { "DeleteUrl", Url.Action("Delete", new { id = item.Id }) },
                                        { "ItemName", item.Nombre },
                                        { "Compact", false }
                                    })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="jk-show-mobile jk-flex jk-flex-col jk-gap-12">
        @foreach (var item in Model)
        {
            <div class="jk-card jk-card-compact">
                <div class="jk-flex-between">
                    <strong>@item.Nombre</strong>
                    @Html.Partial("~/Views/Shared/Components/_TableActions.cshtml",
                        new ViewDataDictionary {
                            { "EditUrl", Url.Action("Edit", new { id = item.Id }) },
                            { "DeleteUrl", Url.Action("Delete", new { id = item.Id }) },
                            { "ItemName", item.Nombre },
                            { "Compact", true }
                        })
                </div>
                <div class="jk-mt-8 jk-small">
                    <i class="bi bi-clock"></i> @item.DuracionMinutos min
                </div>
                <div class="jk-small jk-mt-4">
                    <i class="bi bi-currency-dollar"></i> $ @item.Precio.ToString("N2")
                </div>
            </div>
        }
    </div>
}

@helper EmptyContent() {
    bool hayFiltros = !string.IsNullOrWhiteSpace(ViewBag.Busqueda as string);

    string icon = "briefcase";
    string title = "No tienes servicios";
    string description = "Define los servicios que ofreces para comenzar a agendar turnos.";
    string actionText = "Crear Servicio";
    string actionUrl = Url.Action("Create");

    if (hayFiltros)
    {
        icon = "search";
        title = "Sin resultados";
        description = "No hay servicios que coincidan con la busqueda.";
        actionText = "Ver todos los servicios";
        actionUrl = Url.Action("Index");
    }

    @Html.Partial("~/Views/Shared/Components/_EmptyState.cshtml",
        new ViewDataDictionary {
            { "Icon", icon },
            { "Title", title },
            { "Description", description },
            { "ActionText", actionText },
            { "ActionUrl", actionUrl }
        })
}

@helper FilterContent() {
    <form method="get" action="@Url.Action("Index")" class="jk-filter-bar">
        @Html.Partial("~/Views/Shared/Components/_SearchFilter.cshtml",
            new ViewDataDictionary {
                { "Name", "busqueda" },
                { "Id", "search-servicios" },
                { "Value", ViewBag.Busqueda },
                { "Placeholder", "Buscar por nombre o descripcion..." }
            })

        <button type="submit" class="jk-btn jk-btn-primary">
            <i class="bi bi-search"></i> Buscar
        </button>

        <a href="@Url.Action("Index")" class="jk-btn jk-btn-ghost">
            <i class="bi bi-arrow-counterclockwise"></i> Limpiar
        </a>
    </form>
}

@{
    ViewBag.Title = "Servicios";
    ViewBag.Subtitle = "Administra los servicios que ofreces";
    ViewBag.PrimaryAction = Url.Action("Create");
    ViewBag.PrimaryActionLabel = "Nuevo Servicio";
    ViewBag.ToolbarContent = FilterContent();

    ViewBag.PageContent = Model.Any() ? ListContent() : EmptyContent();
}

@Html.Partial("~/Views/Shared/Components/_CrudPage.cshtml")
