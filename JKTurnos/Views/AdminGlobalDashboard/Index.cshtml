@model JKTurnos.Models.ViewModels.AdminGlobalDashboardViewModel

@{
    ViewBag.Title = "Dashboard Global";
    ViewBag.Subtitle = "Gestion centralizada de la plataforma";
}

@Html.Partial("~/Views/Shared/Components/_PageHeader.cshtml")

<div class="jk-card jk-mb-24">
    <div class="jk-grid">
        @Html.Partial("~/Views/Shared/Components/_KpiCard.cshtml",
            new ViewDataDictionary {
                { "Label", "Tenants Totales" },
                { "Value", Model.TotalTenants.ToString() }
            })
        @Html.Partial("~/Views/Shared/Components/_KpiCard.cshtml",
            new ViewDataDictionary {
                { "Label", "Activos" },
                { "Value", Model.TotalActivos.ToString() }
            })
        @Html.Partial("~/Views/Shared/Components/_KpiCard.cshtml",
            new ViewDataDictionary {
                { "Label", "En Gracia" },
                { "Value", Model.TotalEnGracia.ToString() }
            })
        @Html.Partial("~/Views/Shared/Components/_KpiCard.cshtml",
            new ViewDataDictionary {
                { "Label", "Suspendidos" },
                { "Value", Model.TotalSuspendidos.ToString() }
            })
        @Html.Partial("~/Views/Shared/Components/_KpiCard.cshtml",
            new ViewDataDictionary {
                { "Label", "Pagos Hoy" },
                { "Value", Model.TotalPagosHoy.ToString() }
            })
    </div>
</div>

<div class="jk-grid jk-grid-2">
    @Html.Partial("_AlertasTenants", Model.TenantsEnRiesgo)
    @Html.Partial("_UltimosPagos", Model.UltimosPagos)
</div>
