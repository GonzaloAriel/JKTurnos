@model JKTurnos.Models.Entities.Recurso

@{
    ViewBag.Title = "Eliminar Recurso";
    ViewBag.Subtitle = "Confirma la baja del recurso";
}

@Html.Partial("~/Views/Shared/Components/_PageHeader.cshtml")

<div class="jk-card jk-mt-24">
    <p>¿Estas seguro que deseas eliminar el recurso <strong>@Model.Nombre</strong> (<span>@Model.Tipo</span>)?</p>

    @using (Html.BeginForm("Delete", "Recursos", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id)

        <div class="jk-flex jk-gap-12 jk-mt-16">
            <button type="submit" class="jk-btn jk-btn-danger">
                <i class="bi bi-trash"></i> Si, eliminar
            </button>
            <a href="@Url.Action("Index")" class="jk-btn jk-btn-ghost">
                Cancelar
            </a>
        </div>
    }
</div>