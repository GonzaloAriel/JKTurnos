@model JKTurnos.Models.ViewModels.RecursoViewModel

@helper FormContent() {
    <div class="jk-form-group">
        <label class="jk-label" for="@Html.IdFor(m => m.Recurso.Nombre)">@Html.DisplayNameFor(m => m.Recurso.Nombre)</label>
        @Html.TextBoxFor(m => m.Recurso.Nombre, new { @class = "jk-input", placeholder = "Nombre del recurso" })
        @Html.ValidationMessageFor(m => m.Recurso.Nombre, "", new { @class = "jk-field-error" })
    </div>

    <div class="jk-form-group">
        <label class="jk-label" for="@Html.IdFor(m => m.Recurso.Descripcion)">@Html.DisplayNameFor(m => m.Recurso.Descripcion)</label>
        @Html.TextAreaFor(m => m.Recurso.Descripcion, new { @class = "jk-textarea", placeholder = "Descripcion del recurso", rows = 3 })
        @Html.ValidationMessageFor(m => m.Recurso.Descripcion, "", new { @class = "jk-field-error" })
    </div>

    <div class="jk-form-group">
        <label class="jk-label">Servicios que puede prestar</label>
        @Html.Partial("~/Views/Shared/Components/_CheckboxList.cshtml", Model.TodosLosServicios, new ViewDataDictionary { { "Name", "ServicioIds" }, { "SelectedIds", Model.ServicioIds }, { "ContainerId", "servicios-checkbox-group" } })
        <br />
        <p class="jk-small text-secondary">
            No ves el servicio o lapso de tiempo necesario?
            <br />
            <button type="button" class="jk-btn jk-btn-ghost jk-btn-sm jk-mt-8" data-jk-open-drawer="drawer-quick-servicio">
                <i class="bi bi-plus-lg"></i> Crear nuevo servicio o lapso de tiempo
            </button>
        </p>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="jk-form-group">
                <label class="jk-label" for="@Html.IdFor(m => m.Recurso.Tipo)">Que tipo de recurso es?</label>
                <p class="jk-small text-secondary jk-mt-4">Selecciona la categoria que mejor describa este recurso.</p>
                @Html.EnumDropDownListFor(m => m.Recurso.Tipo, new { @class = "jk-input" })
                @Html.ValidationMessageFor(m => m.Recurso.Tipo, "", new { @class = "jk-field-error" })
            </div>
        </div>
        <div class="col-md-6">
            <div class="jk-form-group">
                <label class="jk-label" for="Color">Color identificatorio</label>
                <p class="jk-small text-secondary jk-mt-4">Se utilizara para distinguir este recurso en el calendario y futuras vistas del sistema.</p>

                @Html.Partial("~/Views/Shared/Components/_ColorSelector.cshtml", new ViewDataDictionary { { "color", Model.Recurso.Color } })

                @Html.ValidationMessageFor(m => m.Recurso.Color, "", new { @class = "jk-field-error" })
            </div>
        </div>
    </div>
}

@{
    ViewBag.Title = "Nuevo recurso reservable";
    ViewBag.Subtitle = "Crea la persona, sala, equipo o espacio que estara disponible para asignar a los turnos.";
    ViewBag.SubmitText = "Guardar";
    ViewBag.CancelUrl = Url.Action("Index");

    ViewBag.FormContent = FormContent();
}

@Html.Partial("~/Views/Shared/Components/_FormLayout.cshtml")

@Html.Partial("~/Views/Shared/Components/_ServiceQuickCreateDrawer.cshtml",
    new ViewDataDictionary {
        { "DrawerId", "drawer-quick-servicio" },
        { "ContainerId", "servicios-checkbox-group" }
    })

