@using JKTurnos.Models.Entities
@model List<JKTurnos.Models.Entities.Recurso>

@helper ListContent() {
    <div class="jk-hide-mobile">
        <div class="jk-table-wrap">
            <table class="jk-table">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Tipo</th>
                        <th class="jk-hide-tablet">Color</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Nombre</td>
                            <td>@item.Tipo</td>
                            <td class="jk-hide-tablet">@item.Color</td>
                            <td>
                                @Html.Partial("~/Views/Shared/Components/_TableActions.cshtml",
                                    new ViewDataDictionary {
                                        { "EditUrl", Url.Action("Edit", new { id = item.Id }) },
                                        { "DeleteUrl", Url.Action("Delete", new { id = item.Id }) },
                                        { "ItemName", item.Nombre },
                                        { "Compact", false }
                                    })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="jk-show-mobile jk-flex jk-flex-col jk-gap-12">
        @foreach (var item in Model)
        {
            <div class="jk-card jk-card-compact">
                <div class="jk-flex-between">
                    <strong>@item.Nombre</strong>
                    @Html.Partial("~/Views/Shared/Components/_TableActions.cshtml",
                        new ViewDataDictionary {
                            { "EditUrl", Url.Action("Edit", new { id = item.Id }) },
                            { "DeleteUrl", Url.Action("Delete", new { id = item.Id }) },
                            { "ItemName", item.Nombre },
                            { "Compact", true }
                        })
                </div>
                <div class="jk-mt-8 jk-small">
                    <i class="bi bi-tag"></i> @item.Tipo
                </div>
                @if (!string.IsNullOrEmpty(item.Color))
                {
                    <div class="jk-small jk-mt-4">
                        <i class="bi bi-palette"></i> @item.Color
                    </div>
                }
            </div>
        }
    </div>
}

@helper EmptyContent() {
    bool hayFiltros = !string.IsNullOrWhiteSpace(ViewBag.Busqueda as string)
        || ViewBag.Tipo != null;

    string icon = "person-badge";
    string title = "No tienes recursos";
    string description = "Define los recursos de tu negocio para comenzar a asignar turnos.";
    string actionText = "Crear Recurso";
    string actionUrl = Url.Action("Create");

    if (hayFiltros)
    {
        icon = "search";
        title = "Sin resultados";
        description = "No hay recursos que coincidan con los filtros.";
        actionText = "Ver todos los recursos";
        actionUrl = Url.Action("Index");
    }

    @Html.Partial("~/Views/Shared/Components/_EmptyState.cshtml",
        new ViewDataDictionary {
            { "Icon", icon },
            { "Title", title },
            { "Description", description },
            { "ActionText", actionText },
            { "ActionUrl", actionUrl }
        })
}

@helper FilterContent() {
    TipoRecurso? tipoFiltro = ViewBag.Tipo as TipoRecurso?;
    List<SelectListItem> tipos = ViewBag.Tipos as List<SelectListItem> ?? new List<SelectListItem>();

    <form method="get" action="@Url.Action("Index")" class="jk-filter-bar">
        @Html.Partial("~/Views/Shared/Components/_SearchFilter.cshtml",
            new ViewDataDictionary {
                { "Name", "busqueda" },
                { "Id", "search-recursos" },
                { "Value", ViewBag.Busqueda },
                { "Placeholder", "Buscar por nombre, descripcion o color..." }
            })

        <div class="jk-form-group jk-filter-field">
            <label class="jk-label" for="tipo">Tipo</label>
            <select id="tipo" name="tipo" class="jk-select">
                <option value="">Todos los tipos</option>
                @foreach (var tipo in tipos)
                {
                    var esSeleccionado = tipoFiltro.HasValue && ((int)tipoFiltro.Value).ToString() == tipo.Value;
                    <option value="@tipo.Value" @(esSeleccionado ? "selected" : "")>@tipo.Text</option>
                }
            </select>
        </div>

        <button type="submit" class="jk-btn jk-btn-primary">
            <i class="bi bi-search"></i> Buscar
        </button>

        <a href="@Url.Action("Index")" class="jk-btn jk-btn-ghost">
            <i class="bi bi-arrow-counterclockwise"></i> Limpiar
        </a>
    </form>
}

@{
    ViewBag.Title = "Recursos";
    ViewBag.Subtitle = "Administra los recursos de tu negocio";
    ViewBag.PrimaryAction = Url.Action("Create");
    ViewBag.PrimaryActionLabel = "Nuevo Recurso";
    ViewBag.ToolbarContent = FilterContent();

    ViewBag.PageContent = Model.Any() ? ListContent() : EmptyContent();
}

@Html.Partial("~/Views/Shared/Components/_CrudPage.cshtml")
