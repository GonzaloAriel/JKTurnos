@model JKTurnos.Models.ViewModels.VidrieraPublicaViewModel

@{
    Layout = "~/Views/Shared/_VidrieraLayout.cshtml";
    ViewBag.Title = Model.NombreNegocio;

    string fmtJornada(System.TimeSpan? ts)
    {
        return ts.HasValue ? ts.Value.ToString(@"hh\:mm") : "";
    }

    var servicios = Model.Servicios;
    var mostrarSchedule = Model.MostrarDisponibilidad && Model.Pantallas.Count > 0;
    var primerPantalla = mostrarSchedule ? Model.Pantallas[0] : null;
    var diasRef = primerPantalla?.Servicios.FirstOrDefault()?.Dias
        ?? new List<JKTurnos.Models.ViewModels.VidrieraDisponibilidadDiaVM>();
    int totalServicios = mostrarSchedule ? primerPantalla.Servicios.Count : 0;
    bool mostrarPromo = Model.MostrarOfertas
        && (!string.IsNullOrWhiteSpace(Model.OfertaTitulo) || !string.IsNullOrWhiteSpace(Model.OfertaDescripcion));

    string ServiceColorClass(int idx)
    {
        return "svc-" + (idx % 12).ToString();
    }
}

<div class="screen">

    <!-- FORMAS DECORATIVAS -->
    <div class="shape circle"></div>
    <div class="shape arc"></div>
    <div class="shape dot dot-a"></div>
    <div class="shape dot dot-b"></div>
    <div class="shape dot dot-c"></div>


    <!-- ======================================================
         HEADER
         ====================================================== -->

    <header class="jk-vidriera-header">

        <div class="jk-vidriera-brand">
            @if (!string.IsNullOrWhiteSpace(Model.LogoUrl))
            {
                <a class="jk-vidriera-marca" href="~/vidriera/@Model.Slug">
                    <img class="jk-vidriera-logo" src="@Model.LogoUrl" alt="@Model.NombreNegocio"
                         style="height:clamp(60px,5vw,88px);width:auto;max-width:200px;object-fit:contain;" />
                </a>
            }
            else
            {
                <div class="jk-vidriera-logo-fallback" aria-hidden="true"
                     style="width:clamp(60px,5vw,88px);height:clamp(60px,5vw,88px);border-radius:50%;background:var(--jk-gradient-tricolor);color:#fff;font-family:'Playfair Display',serif;font-size:clamp(28px,3vw,44px);font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                    @{
                        var inicial = string.IsNullOrWhiteSpace(Model.NombreNegocio)
                            ? "?"
                            : Model.NombreNegocio.Trim().Substring(0, 1).ToUpper();
                    }
                    @inicial
                </div>
            }

            <div class="jk-vidriera-brand-rule"></div>

            <div class="jk-vidriera-brand-description">
                @if (!string.IsNullOrWhiteSpace(Model.Titulo))
                {
                    <p class="jk-vidriera-titulo">@Model.Titulo</p>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Descripcion))
                {
                    <p class="jk-vidriera-descripcion">@Model.Descripcion</p>
                }
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Telefono) ||
             !string.IsNullOrWhiteSpace(Model.Email) ||
             !string.IsNullOrWhiteSpace(Model.Direccion))
        {
            <div class="jk-vidriera-contacto">
                @if (!string.IsNullOrWhiteSpace(Model.Telefono))
                {
                    <span class="jk-vidriera-contacto-item" title="Telefono">
                        <i class="bi bi-telephone"></i> @Model.Telefono
                    </span>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Email))
                {
                    <span class="jk-vidriera-contacto-item" title="Email">
                        <i class="bi bi-envelope"></i> @Model.Email
                    </span>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Direccion))
                {
                    <span class="jk-vidriera-contacto-item" title="Direccion">
                        <i class="bi bi-geo-alt"></i> @Model.Direccion
                    </span>
                }
            </div>
        }

        <div class="jk-vidriera-week-label">
            <small>Agenda</small>
            <strong>Esta semana</strong>
        </div>

    </header>


    <!-- ======================================================
         CONTENIDO
         ====================================================== -->

    <main class="jk-vidriera-main@(mostrarPromo ? "" : " no-promo")">


        <!-- ====================================================
             TABLA DE DISPONIBILIDAD
             ==================================================== -->

        @if (mostrarSchedule)
        {
            <section class="jk-vidriera-schedule"
                     style="grid-template-columns: 11% repeat(@totalServicios, 1fr); grid-template-rows: 13% repeat(7, 1fr);">

                <!-- esquina -->
                <div class="corner"></div>

                <!-- SERVICIOS (cabeceras de columna) -->
                @for (int sIdx = 0; sIdx < totalServicios; sIdx++)
                {
                    var srv = primerPantalla.Servicios[sIdx];
                    <div class="service @ServiceColorClass(sIdx)-head">
                        @srv.ServicioNombre
                    </div>
                }

                <!-- DIAS (filas) -->
                @for (int dIdx = 0; dIdx < diasRef.Count; dIdx++)
                {
                    var dd = diasRef[dIdx];
                    <div class="day">
                        <span class="day-name">@dd.NombreDia</span>
                        <span class="day-num">@dd.DiaDelMes</span>
                    </div>

                    for (int sIdx = 0; sIdx < totalServicios; sIdx++)
                    {
                        var srv = primerPantalla.Servicios[sIdx];
                        var ds = srv.Dias[dIdx];
                        <div class="cell @(dIdx % 2 == 1 ? "day-row-soft" : "")">
                            @if (ds.SinDisponibilidad)
                            {
                                <span class="empty">&mdash;</span>
                            }
                            else
                            {
                                foreach (var r in ds.Rangos)
                                {
                                    <span class="time @ServiceColorClass(sIdx)">@r</span>
                                }
                            }
                        </div>
                    }
                }

            </section>
        }
        else if (Model.MostrarDisponibilidad)
        {
            <section class="jk-vidriera-schedule" style="grid-template-columns: 1fr; grid-template-rows: 1fr;">
                <p class="jk-vidriera-vacio">Sin turnos disponibles.</p>
            </section>
        }
        else
        {
            <section></section>
        }


        <!-- ====================================================
             PROMO
             ==================================================== -->

        @if (mostrarPromo)
        {
            <aside class="jk-vidriera-promo">
                <div class="jk-vidriera-promo-content">

                    <div class="jk-vidriera-promo-top">
                        Promo especial
                    </div>

                    <div class="jk-vidriera-promo-line"></div>

                    @if (!string.IsNullOrWhiteSpace(Model.OfertaTitulo))
                    {
                        <div class="jk-vidriera-promo-title">
                            @Model.OfertaTitulo
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.OfertaDescripcion))
                    {
                        <div class="jk-vidriera-promo-service">
                            @Model.OfertaDescripcion
                        </div>
                    }

                    <div class="jk-vidriera-promo-line"></div>

                </div>
            </aside>
        }

    </main>


    <!-- ======================================================
         PIE
         ====================================================== -->

    <div class="jk-vidriera-footer">
        Disponibilidad semanal &middot; @Model.NombreNegocio
    </div>

</div>

@section scripts {
    <script>
        (function () {
            // Posta 6: refresh periodico cada 5 minutos (300s).
            // La pagina es de monitor (overflow:hidden), el flash de recarga es aceptable.
            setInterval(function () {
                location.reload();
            }, 300000);
        })();
    </script>
}
