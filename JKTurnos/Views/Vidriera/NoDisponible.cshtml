@{
    Layout = "~/Views/Shared/_VidrieraLayout.cshtml";
    ViewBag.Title = "Vidriera no disponible";
    var motivo = ViewBag.Motivo as string ?? "no-existe";
    var titulo = motivo == "no-disponible"
        ? "Esta vidriera no esta disponible temporalmente"
        : "Esta vidriera no existe";
    var descripcion = motivo == "no-disponible"
        ? "El negocio ha desactivado su vidriera publica. Intenta mas tarde."
        : "El enlace que seguiiste no corresponde a una vidriera activa.";
}

<div class="screen" style="display:flex;align-items:center;justify-content:center;">

    <!-- FORMAS DECORATIVAS -->
    <div class="shape circle"></div>
    <div class="shape arc"></div>
    <div class="shape dot dot-a"></div>
    <div class="shape dot dot-b"></div>
    <div class="shape dot dot-c"></div>

    <div style="position:relative;z-index:2;text-align:center;max-width:520px;padding:0 2rem;">

        <div style="font-size:clamp(48px,6vw,80px);margin-bottom:1.5rem;opacity:.25;">
            <i class="bi bi-calendar-x"></i>
        </div>

        <h1 style="font-family:'Playfair Display',serif;font-size:clamp(24px,3vw,40px);font-weight:600;color:var(--jk-text-primary);margin:0 0 1rem 0;line-height:1.2;">
            @titulo
        </h1>

        <p style="color:var(--jk-text-secondary);font-size:clamp(14px,1.1vw,18px);line-height:1.5;margin:0 0 2rem 0;">
            @descripcion
        </p>

        <div style="width:40px;height:1px;background:var(--jk-border);margin:0 auto 2rem auto;"></div>

        <p style="color:var(--jk-text-tertiary);font-size:clamp(10px,.8vw,13px);letter-spacing:.06em;">
            JKTurnos
        </p>

    </div>

</div>
