@* JKTurnos - Form Layout Component. Renders PageHeader + card + form + anti-forgery + form actions. *@

@{
    string submitText = ViewBag.SubmitText ?? "Guardar";
    string cancelUrl = ViewBag.CancelUrl ?? "#";
    var formContent = ViewBag.FormContent;
}

@Html.Partial("~/Views/Shared/Components/_PageHeader.cshtml")

<div class="jk-mt-24">
    <div class="row">
        <div class="col-md-8 col-lg-6">
            <div class="jk-card">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "jk-form-error" })

                    if (formContent != null)
                    {
                        @formContent
                    }

                    @Html.Partial("~/Views/Shared/Components/_FormActions.cshtml",
                        new ViewDataDictionary {
                            { "SubmitText", submitText },
                            { "CancelUrl", cancelUrl }
                        })
                }
            </div>
        </div>
    </div>
</div>
