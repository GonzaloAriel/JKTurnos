@*
    JKTurnos - Agenda Toolbar Component
    Navegacion temporal + selector de vista + filtro de recursos.
*@

@model JKTurnos.Models.ViewModels.AgendaViewModel
@using JKTurnos.Models.Entities

@{
    string dateDisplay = ViewBag.CurrentDateDisplay ?? "";
    var recursos = Model.Recursos != null ? Model.Recursos.ToList() : new List<Recurso>();
}

<div class="jk-agenda-toolbar" role="toolbar" aria-label="Navegacion de agenda">
    <div class="jk-agenda-toolbar-left">
        <div class="jk-agenda-nav">
            <button class="jk-btn-icon" aria-label="Dia anterior" type="button">
                <i class="bi bi-chevron-left"></i>
            </button>
            <button class="jk-btn jk-btn-ghost jk-agenda-today-btn" type="button">
                Hoy
            </button>
            <button class="jk-btn-icon" aria-label="Dia siguiente" type="button">
                <i class="bi bi-chevron-right"></i>
            </button>
            <span class="jk-agenda-date-label" aria-live="polite">@dateDisplay</span>
        </div>
    </div>

    <div class="jk-agenda-toolbar-right">
        <div class="jk-agenda-view-toggle" role="tablist" aria-label="Vista de agenda">
            <button class="jk-btn jk-btn-sm jk-agenda-view-btn active" role="tab" aria-selected="true" type="button">
                Dia
            </button>
            <button class="jk-btn jk-btn-sm jk-btn-ghost jk-agenda-view-btn" role="tab" aria-selected="false" type="button">
                Semana
            </button>
        </div>
    </div>
</div>

@if (recursos.Count > 0)
{
    <div class="jk-agenda-filters" role="group" aria-label="Filtro de recursos">
        <span class="jk-agenda-filter-label">Recursos:</span>
        <div class="jk-agenda-filter-list">
            @foreach (var rec in recursos)
            {
                <label class="jk-agenda-filter-item">
                    <input type="checkbox" checked aria-checked="true" data-recurso-id="@rec.Id" />
                    <span class="jk-agenda-resource-dot" style="background-color: @(rec.Color ?? "#2563eb")"></span>
                    <span class="jk-agenda-resource-name">@rec.Nombre</span>
                </label>
            }
        </div>
    </div>
}
