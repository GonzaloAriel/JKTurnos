@*
    JKTurnos - Agenda Toolbar Component
    Navegacion temporal + selector de vista + filtro de recursos.
*@

@model JKTurnos.Models.ViewModels.AgendaViewModel
@using JKTurnos.Models.Entities

@{
    string dateDisplay = ViewBag.CurrentDateDisplay ?? "";
    string vista = ViewBag.Vista as string ?? "dia";
    DateTime fechaNavegacion = ViewBag.FechaNavegacion != null ? (DateTime)ViewBag.FechaNavegacion : DateTime.Today;
    int delta = vista == "semana" ? 7 : 1;
    var recursos = Model.Recursos != null ? Model.Recursos.ToList() : new List<Recurso>();

    string fechaStr = fechaNavegacion.ToString("yyyy-MM-dd");
    string hoyStr = DateTime.Today.ToString("yyyy-MM-dd");

    string urlAnterior = Url.Action("Agenda", "Turnos", new { fecha = fechaNavegacion.AddDays(-delta).ToString("yyyy-MM-dd"), vista = vista });
    string urlSiguiente = Url.Action("Agenda", "Turnos", new { fecha = fechaNavegacion.AddDays(delta).ToString("yyyy-MM-dd"), vista = vista });
    string urlHoy = Url.Action("Agenda", "Turnos", new { fecha = hoyStr, vista = vista });
    string urlDia = Url.Action("Agenda", "Turnos", new { fecha = fechaStr, vista = "dia" });
    string urlSemana = Url.Action("Agenda", "Turnos", new { fecha = fechaStr, vista = "semana" });
}

<div class="jk-agenda-toolbar" role="toolbar" aria-label="Navegacion de agenda">
    <div class="jk-agenda-toolbar-left">
        <div class="jk-agenda-nav">
            <a href="@urlAnterior" class="jk-btn-icon" aria-label="Anterior">
                <i class="bi bi-chevron-left"></i>
            </a>
            <a href="@urlHoy" class="jk-btn jk-btn-ghost jk-agenda-today-btn">
                Hoy
            </a>
            <a href="@urlSiguiente" class="jk-btn-icon" aria-label="Siguiente">
                <i class="bi bi-chevron-right"></i>
            </a>
            <span class="jk-agenda-date-label" aria-live="polite">@dateDisplay</span>
        </div>
    </div>

    <div class="jk-agenda-toolbar-right">
        <div class="jk-agenda-view-toggle" role="tablist" aria-label="Vista de agenda">
            <a href="@urlDia" class="jk-btn jk-btn-sm jk-agenda-view-btn@(vista == "dia" ? " active" : "")" role="tab" aria-selected="@(vista == "dia" ? "true" : "false")">
                Dia
            </a>
            <a href="@urlSemana" class="jk-btn jk-btn-sm jk-btn-ghost jk-agenda-view-btn@(vista == "semana" ? " active" : "")" role="tab" aria-selected="@(vista == "semana" ? "true" : "false")">
                Semana
            </a>
        </div>
    </div>
</div>

@if (recursos.Count > 0)
{
    <div class="jk-agenda-filters" role="group" aria-label="Filtro de recursos">
        <details class="jk-agenda-filter-dropdown">
            <summary class="jk-agenda-filter-trigger" role="button" aria-label="Filtro de recursos">
                <i class="bi bi-funnel" aria-hidden="true"></i>
                Recursos
                <span class="jk-agenda-filter-count" aria-hidden="true">@recursos.Count</span>
                <i class="bi bi-chevron-down jk-agenda-filter-chevron" aria-hidden="true"></i>
            </summary>
            <div class="jk-agenda-filter-list">
                <span class="jk-agenda-filter-list-title">Mostrar recursos</span>
                @foreach (var rec in recursos)
                {
                    <label class="jk-agenda-filter-item">
                        <input type="checkbox" checked aria-checked="true" data-recurso-id="@rec.Id" />
                        <span class="jk-agenda-resource-dot" style="background-color: @(rec.Color ?? "#2563eb")"></span>
                        <span class="jk-agenda-resource-name">@rec.Nombre</span>
                    </label>
                }
            </div>
        </details>
    </div>
}
