@*
    JKTurnos - Turno Detail Drawer Content
    Contenido del Inspector Drawer del Time Block (V1, solo lectura).
    Este partial se inyecta via fetch en el drawer contenedor montado en
    Agenda.cshtml (jk-agenda.js). No renderiza el drawer completo:

        fetch('@Url.Action("GetDetailDrawer", "Turnos")?id=' + id)
            .then(r => r.text())
            .then(html => body.innerHTML = html)

    EstadoEconomico es un slot reservado para V3 (Docs/16): el espacio de
    Pagos se muestra siempre, con estado economico real o placeholder
    "Sin senia" hasta que exista el modelo de pagos.
*@

@model JKTurnos.Models.ViewModels.TurnoDetailViewModel

<div class="jk-drawer-section">
    <div class="jk-flex jk-flex-between">
        <h4 class="jk-drawer-subtitle">@Model.ClienteNombre</h4>
        <span class="jk-badge" style="--jk-status-color: @(Model.EstadoColor ?? "#aeaeb2");">
            <i class="bi bi-circle-fill" style="color: @(Model.EstadoColor ?? "#aeaeb2");"></i> @Model.EstadoNombre
        </span>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ClienteTelefono) || !string.IsNullOrWhiteSpace(Model.ClienteEmail))
    {
        <p class="jk-small text-secondary jk-mt-4">
            @Model.ClienteTelefono
            @if (!string.IsNullOrWhiteSpace(Model.ClienteTelefono) && !string.IsNullOrWhiteSpace(Model.ClienteEmail))
            {<text> · </text>}
            @Model.ClienteEmail
        </p>
    }
</div>

<div class="jk-drawer-section">
    <div class="jk-flex jk-flex-between">
        <span class="jk-drawer-label">Servicio</span>
        <span>@(Model.ServicioNombre ?? "Sin servicio")</span>
    </div>

    @if (Model.ServicioDuracionMinutos.HasValue)
    {
        <div class="jk-flex jk-flex-between jk-mt-4">
            <span class="jk-drawer-label">Duracion</span>
            <span>@Model.ServicioDuracionMinutos.Value min</span>
        </div>
    }

    @if (Model.ServicioPrecio.HasValue)
    {
        <div class="jk-flex jk-flex-between jk-mt-4">
            <span class="jk-drawer-label">Precio</span>
            <span>@Model.ServicioPrecio.Value.ToString("0.00")</span>
        </div>
    }

    <div class="jk-flex jk-flex-between jk-mt-4">
        <span class="jk-drawer-label">Recurso</span>
        <span class="jk-flex jk-gap-8">
            <span class="jk-agenda-resource-dot" style="background-color: @(Model.RecursoColor ?? "#2563eb");"></span>
            @Model.RecursoNombre
        </span>
    </div>
</div>

<div class="jk-drawer-section">
    <div class="jk-flex jk-flex-between">
        <span class="jk-drawer-label">Fecha y hora</span>
        <span>@Model.FechaHoraInicio.ToString("dd/MM/yyyy")</span>
    </div>
    <div class="jk-flex jk-flex-between jk-mt-4">
        <span class="jk-drawer-label">Horario</span>
        <span>@Model.FechaHoraInicio.ToString("HH:mm") - @Model.FechaHoraFin.ToString("HH:mm")</span>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.WhatsAppLink))
    {
        <a href="@Model.WhatsAppLink"
           class="jk-btn jk-btn-sm jk-btn-whatsapp jk-mt-12"
           target="_blank"
           rel="noopener noreferrer"
           title="Abre WhatsApp con el recordatorio del turno prellenado">
            <i class="bi bi-whatsapp"></i> Recordar por WhatsApp
        </a>
    }
</div>

@if (!string.IsNullOrWhiteSpace(Model.Observaciones))
{
    <div class="jk-drawer-section">
        <span class="jk-drawer-label">Observaciones</span>
        <p class="jk-small jk-mt-4">@Model.Observaciones</p>
    </div>
}

<div class="jk-drawer-section">
    <div class="jk-flex jk-flex-between">
        <span class="jk-drawer-label">Pagos</span>
        <span class="jk-flex jk-flex-wrap jk-gap-8">
            @if (Model.ServicioPrecio.HasValue)
            {
                <span class="jk-small text-secondary">Precio: @Model.ServicioPrecio.Value.ToString("0.00")</span>
            }
            <span class="jk-badge">@Model.EstadoEconomico</span>
        </span>
    </div>

    @if (Model.Pagos != null && Model.Pagos.Count > 0)
    {
        <ul class="jk-pago-lista jk-mt-8">
            @foreach (var pago in Model.Pagos)
            {
                <li class="jk-pago-item">
                    <div class="jk-flex jk-flex-between">
                        <strong>$ @pago.Monto.ToString("0.00")</strong>
                        <span class="jk-small text-secondary">@pago.Fecha.ToString("dd/MM HH:mm")</span>
                    </div>
                    <div class="jk-small">@pago.TipoPago</div>
                    @if (!string.IsNullOrWhiteSpace(pago.Observacion))
                    {
                        <div class="jk-small text-secondary">@pago.Observacion</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(pago.UsuarioNombre))
                    {
                        <div class="jk-small text-secondary">por @pago.UsuarioNombre</div>
                    }
                </li>
            }
        </ul>
    }

    @if (Model.PuedeEditarPagos)
    {
        <div class="jk-flex jk-gap-8 jk-mt-8">
            <button type="button" class="jk-btn jk-btn-primary jk-btn-sm" data-pago-accion="Senia" data-turno-id="@Model.Id">Registrar senia</button>
            <button type="button" class="jk-btn jk-btn-secondary jk-btn-sm" data-pago-accion="Pago" data-turno-id="@Model.Id">Registrar pago</button>
        </div>

        <form class="jk-pago-form jk-mt-8" data-turno-id="@Model.Id" hidden>
            @Html.AntiForgeryToken()
            <input type="hidden" name="TurnoId" value="@Model.Id" />
            <div class="jk-form-group">
                <label class="jk-label">Monto</label>
                <input type="number" name="Monto" class="jk-input" min="0.01" step="0.01" required />
            </div>
            <div class="jk-form-group">
                <label class="jk-label">Tipo</label>
                <select name="TipoPago" class="jk-select">
                    <option value="PagoParcial">Pago parcial</option>
                    <option value="PagoTotal">Pago total</option>
                    <option value="Senia">Senia</option>
                </select>
            </div>
            <div class="jk-form-group">
                <label class="jk-label">Observacion</label>
                <input type="text" name="Observacion" class="jk-input" />
            </div>
            <div class="jk-flex jk-gap-8">
                <button type="submit" class="jk-btn jk-btn-primary jk-btn-sm">Guardar</button>
                <button type="button" class="jk-btn jk-btn-ghost jk-btn-sm" data-pago-cancelar>Cancelar</button>
            </div>
            <p class="jk-field-error jk-pago-error jk-mt-8" hidden></p>
        </form>
    }
</div>