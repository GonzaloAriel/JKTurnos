@*
    JKTurnos - Turno Detail Drawer Content
    Contenido del Inspector Drawer del Time Block.
    Este partial se inyecta via fetch en el drawer contenedor montado en
    Agenda.cshtml (jk-agenda.js). No renderiza el drawer completo:

        fetch('@Url.Action("GetDetailDrawer", "Turnos")?id=' + id)
            .then(r => r.text())
            .then(html => body.innerHTML = html)

    El drawer es operable: ademas del detalle (solo lectura), incluye acciones
    contextuales de estado (Iniciar/Finalizar/Cancelar, P5/D-040) que se operan
    directo sin ir al Edit, y la seccion economica de Pagos (V3/D-028).

    EstadoEconomico es un slot reservado para V3 (Docs/16): el espacio de
    Pagos se muestra siempre, con estado economico real o placeholder
    "Sin senia" hasta que exista el modelo de pagos.
*@

@model JKTurnos.Models.ViewModels.TurnoDetailViewModel

@using JKTurnos.Models.Entities

@Html.AntiForgeryToken()

<div class="jk-drawer-section">
    <div class="jk-flex jk-flex-between">
        <h4 class="jk-drawer-subtitle">@Model.ClienteNombre</h4>
        <span class="jk-badge">
            <i class="bi @(Model.EstadoIcono ?? "bi-circle-fill")"></i> @Model.EstadoNombre
            @if (Model.SituacionClave != null && SituacionTemporal.EsAlarma(Model.SituacionClave))
            {
                <i class="bi @Model.SituacionIcono" title="@Model.SituacionLabel" style="color: @Model.SituacionColor; margin-left: 6px;"></i>
            }
        </span>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ClienteTelefono) || !string.IsNullOrWhiteSpace(Model.ClienteEmail))
    {
        <p class="jk-small text-secondary jk-mt-4">
            @Model.ClienteTelefono
            @if (!string.IsNullOrWhiteSpace(Model.ClienteTelefono) && !string.IsNullOrWhiteSpace(Model.ClienteEmail))
            {<text> · </text>}
            @Model.ClienteEmail
        </p>
    }
</div>

@if (Model.PuedeIniciar || Model.PuedeFinalizar || Model.PuedeCancelar)
{
    <div class="jk-drawer-section">
        <div class="jk-flex jk-gap-8 jk-flex-wrap">
            @if (Model.PuedeIniciar)
            {
                <button type="button" class="jk-btn jk-btn-sm jk-btn-soft-success" data-accion data-url="@Url.Action("IniciarAtencion", "Turnos")" data-turno="@Model.Id" title="Iniciar atencion" aria-label="Iniciar atencion de @Model.ClienteNombre">
                    <i class="bi bi-play-fill"></i> Iniciar atencion
                </button>
            }
            @if (Model.PuedeFinalizar)
            {
                <button type="button" class="jk-btn jk-btn-sm jk-btn-soft-success" data-accion data-url="@Url.Action("FinalizarAtencion", "Turnos")" data-turno="@Model.Id" title="Finalizar atencion" aria-label="Finalizar atencion de @Model.ClienteNombre">
                    <i class="bi bi-check-lg"></i> Finalizar
                </button>
            }
            @if (Model.PuedeCancelar)
            {
                <button type="button" class="jk-btn jk-btn-sm jk-btn-soft-danger" data-accion data-url="@Url.Action("CancelarAtencion", "Turnos")" data-turno="@Model.Id" title="Cancelar turno" aria-label="Cancelar turno de @Model.ClienteNombre">
                    <i class="bi bi-x-lg"></i> Cancelar
                </button>
            }
            <button type="button" class="jk-btn jk-btn-sm jk-btn-soft-info" data-mover-toggle title="Mover turno a otro horario o recurso" aria-label="Mover turno de @Model.ClienteNombre">
                <i class="bi bi-arrows-move"></i> Mover turno
            </button>
        </div>

        @*
            M-07: formulario inline "Mover turno" (alternativa al drag & drop,
            pensado tambien para mobile). POST ajax a Turnos/Mover con el mismo
            patron QuickCreate (D-013); el backend valida disponibilidad.
        *@
        <form class="jk-mover-form jk-mt-12" data-turno-id="@Model.Id" data-mover-url="@Url.Action("Mover", "Turnos")" hidden novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" name="turnoId" value="@Model.Id" />
            <input type="hidden" name="fechaHoraInicio" />
            <div class="jk-form-group">
                <label class="jk-label">Recurso</label>
                <select name="recursoId" class="jk-input">
                    @if (Model.Recursos != null)
                    {
                        foreach (var r in Model.Recursos)
                        {
                            <option value="@r.Value" @(Model.RecursoId.ToString() == r.Value ? "selected" : "")>@r.Text</option>
                        }
                    }
                </select>
            </div>
            <div class="jk-flex jk-gap-8">
                <div class="jk-form-group jk-flex-1">
                    <label class="jk-label">Fecha</label>
                    <input type="date" name="moverFecha" class="jk-input" value="@Model.FechaHoraInicio.ToString("yyyy-MM-dd")" min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                </div>
                <div class="jk-form-group jk-flex-1">
                    <label class="jk-label">Hora</label>
                    <input type="time" name="moverHora" class="jk-input" value="@Model.FechaHoraInicio.ToString("HH:mm")" />
                </div>
            </div>
            <div class="jk-flex jk-gap-8">
                <button type="submit" class="jk-btn jk-btn-primary jk-btn-sm">Mover</button>
                <button type="button" class="jk-btn jk-btn-ghost jk-btn-sm" data-mover-cancel>Cancelar</button>
            </div>
            <p class="jk-field-error jk-mover-error jk-mt-8" hidden></p>
        </form>
    </div>
}

<div class="jk-drawer-section">
    <div class="jk-flex jk-flex-between">
        <span class="jk-drawer-label">Servicio</span>
        <span>@(Model.ServicioNombre ?? "Sin servicio")</span>
    </div>

    @if (Model.ServicioDuracionMinutos.HasValue)
    {
        <div class="jk-flex jk-flex-between jk-mt-4">
            <span class="jk-drawer-label">Duracion</span>
            <span>@Model.ServicioDuracionMinutos.Value min</span>
        </div>
    }

    @if (Model.ServicioPrecio.HasValue)
    {
        <div class="jk-flex jk-flex-between jk-mt-4">
            <span class="jk-drawer-label">Precio</span>
            <span>@Model.ServicioPrecio.Value.ToString("0.00")</span>
        </div>
    }

    <div class="jk-flex jk-flex-between jk-mt-4">
        <span class="jk-drawer-label">Recurso</span>
        <span class="jk-flex jk-gap-8">
            <span class="jk-agenda-resource-dot" style="background-color: @(Model.RecursoColor ?? "#7295B5");"></span>
            @Model.RecursoNombre
        </span>
    </div>
</div>

<div class="jk-drawer-section">
    <div class="jk-flex jk-flex-between">
        <span class="jk-drawer-label">Fecha y hora</span>
        <span>@Model.FechaHoraInicio.ToString("dd/MM/yyyy")</span>
    </div>
    <div class="jk-flex jk-flex-between jk-mt-4">
        <span class="jk-drawer-label">Horario</span>
        <span>@Model.FechaHoraInicio.ToString("HH:mm") - @Model.FechaHoraFin.ToString("HH:mm")</span>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.WhatsAppLink))
    {
        <a href="@Model.WhatsAppLink"
           class="jk-btn jk-btn-sm jk-btn-whatsapp jk-mt-12"
           target="_blank"
           rel="noopener noreferrer"
           title="Abre WhatsApp con el recordatorio del turno prellenado">
            <i class="bi bi-whatsapp"></i> Recordar por WhatsApp
        </a>
    }

    @if (Model.PuedeEnviarEmail)
    {
        <button type="button"
                class="jk-btn jk-btn-sm jk-btn-secondary jk-mt-12"
                data-enviar-email="@Model.Id"
                data-enviar-email-url="@Url.Action("EnviarRecordatorioEmail", "Turnos")"
                title="Envia el recordatorio del turno al email del cliente">
            <i class="bi bi-envelope"></i> Enviar recordatorio por email
        </button>
    }
</div>

@if (!string.IsNullOrWhiteSpace(Model.Observaciones))
{
    <div class="jk-drawer-section">
        <span class="jk-drawer-label">Observaciones</span>
        <p class="jk-small jk-mt-4">@Model.Observaciones</p>
    </div>
}

<div class="jk-drawer-section jk-drawer-section-economica">
    <div class="jk-flex jk-flex-between">
        <span class="jk-drawer-label">Pagos</span>
        <span class="jk-flex jk-flex-wrap jk-gap-8">
            @if (Model.ServicioPrecio.HasValue)
            {
                <span class="jk-small text-secondary">Precio: @Model.ServicioPrecio.Value.ToString("0.00")</span>
            }
            <span class="jk-badge">@Model.EstadoEconomico</span>
        </span>
    </div>

    @if (Model.Pagos != null && Model.Pagos.Count > 0)
    {
        <ul class="jk-pago-lista jk-mt-8">
            @foreach (var pago in Model.Pagos)
            {
                <li class="jk-pago-item">
                    <div class="jk-flex jk-flex-between">
                        <strong>$ @pago.Monto.ToString("0.00")</strong>
                        <span class="jk-small text-secondary">@pago.Fecha.ToString("dd/MM HH:mm")</span>
                    </div>
                    <div class="jk-small">@pago.TipoPago</div>
                    @if (!string.IsNullOrWhiteSpace(pago.Observacion))
                    {
                        <div class="jk-small text-secondary">@pago.Observacion</div>
                    }
                </li>
            }
        </ul>
    }

    @if (Model.PuedeEditarPagos)
    {
        <div class="jk-flex jk-gap-8 jk-mt-8">
            <button type="button" class="jk-btn jk-btn-secondary jk-btn-sm" data-pago-accion="Pago" data-turno-id="@Model.Id">Registrar pago</button>
        </div>

        <form class="jk-pago-form jk-mt-8" data-turno-id="@Model.Id" hidden>
            @Html.AntiForgeryToken()
            <input type="hidden" name="TurnoId" value="@Model.Id" />
            <div class="jk-form-group">
                <label class="jk-label">Monto</label>
                <input type="number" name="Monto" class="jk-input" min="0.01" step="0.01" required />
            </div>
            <div class="jk-form-group">
                <label class="jk-label">Tipo</label>
                <select name="TipoPago" class="jk-select">
                    <option value="PagoParcial">Pago parcial</option>
                    <option value="PagoTotal">Pago total</option>
                    <option value="Senia">Seña</option>
                </select>
            </div>
            <div class="jk-form-group">
                <label class="jk-label">Observacion</label>
                <input type="text" name="Observacion" class="jk-input" />
            </div>
            <div class="jk-flex jk-gap-8">
                <button type="submit" class="jk-btn jk-btn-primary jk-btn-sm">Guardar</button>
                <button type="button" class="jk-btn jk-btn-ghost jk-btn-sm" data-pago-cancelar>Cancelar</button>
            </div>
            <p class="jk-field-error jk-pago-error jk-mt-8" hidden></p>
        </form>
    }
</div>