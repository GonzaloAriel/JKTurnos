@*
    JKTurnos - Agenda Grid Component
    Grilla de calendario con columna de horas sticky y fila de recursos sticky.
    Renderiza los Time Blocks de los turnos del dia seleccionado (server-side).
    Todos los items usan posicionamiento explicito (grid-row/grid-column) para que
    los Time Blocks se superpongan a las celdas sin desplazarlas (no hay auto-placement).
*@

@model JKTurnos.Models.ViewModels.AgendaViewModel
@using JKTurnos.Models.Entities

@{
    var recursos = Model.Recursos != null ? Model.Recursos.ToList() : new List<Recurso>();
    var turnos = Model.Turnos != null ? Model.Turnos.ToList() : new List<Turno>();
    var fecha = Model.Fecha;

    var gridInicio = new DateTime(fecha.Year, fecha.Month, fecha.Day, 8, 0, 0);
    var gridFin = new DateTime(fecha.Year, fecha.Month, fecha.Day, 19, 30, 0);

    if (turnos.Count > 0)
    {
        var minInicio = turnos.Min(t => t.FechaHoraInicio);
        var maxFin = turnos.Max(t => t.FechaHoraFin);

        var inicioAjustado = new DateTime(fecha.Year, fecha.Month, fecha.Day,
            minInicio.Hour, minInicio.Minute >= 30 ? 30 : 0, 0);
        if (inicioAjustado < gridInicio)
        {
            gridInicio = inicioAjustado;
        }

        int finMinutos = maxFin.Minute > 30 ? 60 : (maxFin.Minute > 0 ? 30 : 0);
        var finAjustado = new DateTime(fecha.Year, fecha.Month, fecha.Day, maxFin.Hour, 0, 0).AddMinutes(finMinutos);
        if (finAjustado > gridFin)
        {
            gridFin = finAjustado;
        }
    }

    int franjaMinutos = 30;

    var horas = new List<DateTime>();
    var cursor = gridInicio;
    while (cursor < gridFin)
    {
        horas.Add(cursor);
        cursor = cursor.AddMinutes(franjaMinutos);
    }
    int hourCount = horas.Count;
    int filasFranja = hourCount;
    int filasTotal = filasFranja + 1;

    var columnaRecurso = new Dictionary<int, int>();
    for (int i = 0; i < recursos.Count; i++)
    {
        columnaRecurso[recursos[i].Id] = i;
    }
}

@if (recursos.Count == 0)
{
    @Html.Partial("~/Views/Shared/Components/_EmptyState.cshtml",
        new ViewDataDictionary {
            { "Icon", "collection" },
            { "Title", "Necesitas agregar al menos un recurso" },
            { "Description", "Sin recursos no puedes reservar turnos. Crea tu primer recurso para comenzar." },
            { "ActionText", "Crear Recurso" },
            { "ActionUrl", Url.Action("Create", "Recursos") }
        })
}
else if (Model.DiasLaborales != null && Model.DiasLaborales.Count > 0 && !Model.DiasLaborales.Contains(fecha.DayOfWeek))
{
    @Html.Partial("~/Views/Shared/Components/_EmptyState.cshtml",
        new ViewDataDictionary {
            { "Icon", "calendar-x" },
            { "Title", "Este dia no es laborable" },
            { "Description", "La configuracion del negocio indica que este dia no se trabaja. Selecciona un dia laborable en la agenda." },
            { "ActionText", "Volver a la semana" },
            { "ActionUrl", Url.Action("Agenda", "Turnos", new { vista = "semana" }) }
        })
}
else
{
    <div class="jk-agenda-grid-wrap" role="grid" aria-label="Grilla de agenda">
        <div class="jk-agenda-grid" style="--jk-resource-count: @recursos.Count; --jk-grid-filas: @filasFranja;">

            @* Corner cell (fila 1, columna 1) *@
            <div class="jk-agenda-corner" style="grid-row: 1; grid-column: 1;" role="presentation"></div>

            @* Resource headers (fila 1) *@
            @for (int i = 0; i < recursos.Count; i++)
            {
                var rec = recursos[i];
                <div class="jk-agenda-resource-header" data-recurso-id="@rec.Id" style="grid-row: 1; grid-column: @(i + 2);" role="columnheader" aria-label="@rec.Nombre">
                    <span class="jk-agenda-resource-dot" style="background-color: @(rec.Color ?? "#7295B5")"></span>
                    <span class="jk-agenda-resource-name">@rec.Nombre</span>
                </div>
            }

            @* Hour rows + cells (filas 2..25) *@
            @for (int h = 0; h < hourCount; h++)
            {
                var hour = horas[h];
                var horaTexto = hour.ToString("HH:mm");
                int fila = h + 2;

                <div class="jk-agenda-hour" style="grid-row: @fila; grid-column: 1;" role="rowheader" aria-label="@horaTexto">
                    @if (hour.Minute == 0)
                    {
                        <span class="jk-agenda-hour-text">@horaTexto</span>
                    }
                </div>

                for (int i = 0; i < recursos.Count; i++)
                {
                    var rec = recursos[i];
                    if (hour.Minute == 0)
                    {
                        @:<div class="jk-agenda-cell jk-agenda-cell-hour-start" data-recurso-id="@rec.Id" style="grid-row: @fila; grid-column: @(i + 2);" role="gridcell" data-hour="@horaTexto" aria-label="@rec.Nombre @horaTexto"></div>
                    }
                    else
                    {
                        @:<div class="jk-agenda-cell" data-recurso-id="@rec.Id" style="grid-row: @fila; grid-column: @(i + 2);" role="gridcell" data-hour="@horaTexto" aria-label="@rec.Nombre @horaTexto"></div>
                    }
                }
            }

            @* Time blocks (overlay: se superponen a las celdas de su columna) *@
            @foreach (var t in turnos)
            {                int colIdx;
                if (!columnaRecurso.TryGetValue(t.RecursoId, out colIdx))
                {
                    continue;
                }

                var inicio = t.FechaHoraInicio < gridInicio ? gridInicio : t.FechaHoraInicio;
                var fin = t.FechaHoraFin > gridFin ? gridFin : t.FechaHoraFin;
                if (inicio >= gridFin || fin <= inicio)
                {
                    continue;
                }

                int franjaInicio = (int)Math.Floor((inicio - gridInicio).TotalMinutes / franjaMinutos);
                int franjaSpan = Math.Max(1, (int)Math.Ceiling((fin - inicio).TotalMinutes / franjaMinutos));

                if (franjaInicio >= filasFranja)
                {
                    continue;
                }
                if (franjaInicio + franjaSpan > filasFranja)
                {
                    franjaSpan = filasFranja - franjaInicio;
                }

                int durationSlots = franjaSpan;

                int gridRowStart = franjaInicio + 2;
                int gridRowEnd = gridRowStart + franjaSpan;
                int gridColumn = colIdx + 2;

                var recurso = recursos[colIdx];
                var clienteNombre = t.Cliente != null ? t.Cliente.Nombre : "Sin cliente";
                var servicioNombre = t.Servicio != null ? t.Servicio.Nombre : "Reservado";
                var recursoColor = recurso.Color ?? "#7295B5";
                var estadoNombre = t.EstadoTurno != null ? t.EstadoTurno.Nombre : "";
                var estadoIcono = t.EstadoTurno != null ? t.EstadoTurno.Icono : "bi-circle-fill";
                var estadoCodigo = t.EstadoTurno != null ? t.EstadoTurno.Codigo : null;
                var movible = estadoCodigo == EstadosTurnoBase.Pendiente || estadoCodigo == EstadosTurnoBase.EnCurso;
                var situacionClave = SituacionTemporal.Calcular(t);
                var situacionAlarma = situacionClave != null && SituacionTemporal.EsAlarma(situacionClave) ? SituacionTemporal.De(situacionClave) : null;

                <div class="jk-agenda-time-block@(durationSlots == 1 ? " is-compact" : "")"
                     role="button"
                     tabindex="0"
                     data-turno-id="@t.Id"
                     data-recurso-id="@t.RecursoId"
                     data-estado-codigo="@estadoCodigo"
                     data-movible="@(movible ? "true" : "false")"
                     style="grid-column: @gridColumn; grid-row: @gridRowStart / @gridRowEnd; --jk-block-color: @recursoColor;"
                     aria-label="Turno de @clienteNombre, @servicioNombre, @estadoNombre, @t.FechaHoraInicio.ToString("HH:mm")">
                    <div class="jk-agenda-time-block-band">
                        <span class="jk-agenda-time-block-hour">@t.FechaHoraInicio.ToString("HH:mm") - @t.FechaHoraFin.ToString("HH:mm")</span>
                        <span class="jk-agenda-time-block-actions">
                            <button type="button" class="jk-agenda-time-block-pago" data-turno-id="@t.Id" title="Registrar pago" aria-label="Registrar pago de @clienteNombre">
                                <i class="bi bi-cash-coin"></i>
                            </button>
                            <span class="jk-agenda-time-block-menu" aria-hidden="true"><i class="bi bi-three-dots"></i></span>
                        </span>
                    </div>
                    <div class="jk-agenda-time-block-body">
                        <div class="jk-agenda-time-block-title">
                            <span class="jk-agenda-time-block-status" title="@estadoNombre"><i class="bi @estadoIcono"></i></span>
                            @if (situacionAlarma != null)
                            {
                                <span class="jk-agenda-time-block-status" title="@situacionAlarma.Label" style="color: @situacionAlarma.Color"><i class="bi @situacionAlarma.Icono"></i></span>
                            }
                            <span class="jk-agenda-time-block-client">@clienteNombre</span>
                        </div>
                        <span class="jk-agenda-time-block-service">@servicioNombre</span>
                    </div>
                </div>
            }

            @* Bloqueos de disponibilidad (D-046, grises, overlay) *@
            @if (Model.Bloqueos != null)
            {
                foreach (var b in Model.Bloqueos)
                {
                    bool aplicaDia = false;
                    switch (b.Tipo)
                    {
                        case JKTurnos.Models.Entities.TipoBloqueo.Unico:
                            aplicaDia = b.FechaInicio.Date == fecha.Date;
                            break;
                        case JKTurnos.Models.Entities.TipoBloqueo.RangoFechas:
                            var rFechaFin = b.FechaFin.HasValue ? b.FechaFin.Value.Date : b.FechaInicio.Date;
                            aplicaDia = fecha.Date >= b.FechaInicio.Date && fecha.Date <= rFechaFin;
                            break;
                        default:
                            aplicaDia = fecha.DayOfWeek == b.FechaInicio.DayOfWeek;
                            break;
                    }
                    if (!aplicaDia) { continue; }

                    int colIdx;
                    if (!columnaRecurso.TryGetValue(b.RecursoId, out colIdx)) { continue; }

                    DateTime bInicio = new DateTime(fecha.Year, fecha.Month, fecha.Day, gridInicio.Hour, gridInicio.Minute, 0);
                    DateTime bFin = new DateTime(fecha.Year, fecha.Month, fecha.Day, gridFin.Hour, gridFin.Minute, 0);

                    if (b.HoraInicio.HasValue && b.HoraFin.HasValue)
                    {
                        var diaBase = fecha.Date;
                        bInicio = diaBase.Add(b.HoraInicio.Value);
                        bFin = diaBase.Add(b.HoraFin.Value);
                    }

                    if (bInicio < gridInicio) { bInicio = gridInicio; }
                    if (bFin > gridFin) { bFin = gridFin; }
                    if (bInicio >= gridFin || bFin <= bInicio) { continue; }

                    int bFranjaInicio = (int)Math.Floor((bInicio - gridInicio).TotalMinutes / franjaMinutos);
                    int bFranjaSpan = Math.Max(1, (int)Math.Ceiling((bFin - bInicio).TotalMinutes / franjaMinutos));
                    if (bFranjaInicio >= filasFranja) { continue; }
                    if (bFranjaInicio + bFranjaSpan > filasFranja) { bFranjaSpan = filasFranja - bFranjaInicio; }

                    int bGridRowStart = bFranjaInicio + 2;
                    int bGridRowEnd = bGridRowStart + bFranjaSpan;
                    int bGridColumn = colIdx + 2;

                    string bDesc = !string.IsNullOrWhiteSpace(b.Descripcion) ? b.Descripcion : "No disponible";

                    <div class="jk-bloqueo-recurso"
                         role="status"
                         data-bloqueo-id="@b.Id"
                         data-recurso-id="@b.RecursoId"
                         style="grid-column: @bGridColumn; grid-row: @bGridRowStart / @bGridRowEnd;"
                         aria-label="Bloqueo: @bDesc">
                        <div class="jk-bloqueo-recurso-band">
                            <i class="bi bi-calendar-x" aria-hidden="true"></i>
                            <span class="jk-bloqueo-recurso-hour">@bInicio.ToString("HH:mm") - @bFin.ToString("HH:mm")</span>
                        </div>
                        <div class="jk-bloqueo-recurso-label">No disponible</div>
                    </div>
                }
            }

        </div>
    </div>

    if (turnos.Count == 0)
    {
        <div class="jk-agenda-empty-day">
            <span class="jk-agenda-empty-day-text">No tienes turnos hoy</span>
            <a href="@Url.Action("Create", "Turnos")" class="jk-btn jk-btn-primary jk-btn-sm">Reservar turno</a>
        </div>
    }
}
