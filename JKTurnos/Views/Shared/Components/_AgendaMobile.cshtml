@*
    JKTurnos - Agenda Mobile Component (tarjetas por Recurso + horarios libres)
    Variante mobile (< 768px) de la Agenda: acordeon por Recurso usando
    <details>/<summary> (sin JS obligatorio). Cada recurso lista sus turnos
    del dia y los horarios libres (franjas de 30 min desocupadas en el rango
    del dia, fusionadas en rangos continuos). D-019.
    La grilla desktop sigue en _AgendaGrid (se oculta por media query).
    El clic en un turno abre el mismo Drawer de detalle (jk-agenda.js).
    El calculo de horarios libres vive en la vista; si D-017 (quick-create)
    lo necesita se extrae a un servicio.
*@

@model JKTurnos.Models.ViewModels.AgendaViewModel
@using JKTurnos.Models.Entities

@{
    var recursos = Model.Recursos != null ? Model.Recursos.OrderBy(r => r.Nombre).ToList() : new List<Recurso>();
    var turnos = Model.Turnos != null ? Model.Turnos.OrderBy(t => t.FechaHoraInicio).ToList() : new List<Turno>();
    var fecha = Model.Fecha;

    Func<JKTurnos.Models.Entities.BloqueoRecurso, DateTime, DateTime, bool> FranjaBloqueada = (b, fini, ffin) =>
    {
        if (!b.HoraInicio.HasValue || !b.HoraFin.HasValue)
            return true; // todo el dia: siempre ocupa.
        if (b.HoraInicio.Value >= b.HoraFin.Value)
            return true;
        var diaBase = fecha.Date;
        var bIni = diaBase.Add(b.HoraInicio.Value);
        var bFin = diaBase.Add(b.HoraFin.Value);
        return fini < bFin && ffin > bIni;
    };

    var gridInicio = new DateTime(fecha.Year, fecha.Month, fecha.Day, 8, 0, 0);
    var gridFin = new DateTime(fecha.Year, fecha.Month, fecha.Day, 19, 30, 0);

    if (turnos.Count > 0)
    {
        var minInicio = turnos.Min(t => t.FechaHoraInicio);
        var maxFin = turnos.Max(t => t.FechaHoraFin);

        var inicioAjustado = new DateTime(fecha.Year, fecha.Month, fecha.Day,
            minInicio.Hour, minInicio.Minute >= 30 ? 30 : 0, 0);
        if (inicioAjustado < gridInicio)
        {
            gridInicio = inicioAjustado;
        }

        int finMinutos = maxFin.Minute > 30 ? 60 : (maxFin.Minute > 0 ? 30 : 0);
        var finAjustado = new DateTime(fecha.Year, fecha.Month, fecha.Day, maxFin.Hour, 0, 0).AddMinutes(finMinutos);
        if (finAjustado > gridFin)
        {
            gridFin = finAjustado;
        }
    }

    // D-050 / M-01: rangos de atencion del dia. Los horarios libres solo se
    // ofrecen dentro de estos rangos (la franja fuera de horario se trata
    // como ocupada a los efectos de "agregar turno").
    List<RangoAtencion> rangosDia = null;
    if (Model.HorarioAtencion != null)
    {
        Model.HorarioAtencion.TryGetValue(fecha.DayOfWeek, out rangosDia);
    }

    // El rango visible de horarios libres abarca tambien el horario de atencion
    // del dia (para que las franjas EN horario puedan ofrecerse).
    if (rangosDia != null)
    {
        foreach (var r in rangosDia)
        {
            TimeSpan ini, fin;
if (!TimeSpan.TryParse(r.Inicio, out ini) || !TimeSpan.TryParse(r.Fin, out fin))
                {
                    continue;
                }

            var iniAjustado = new DateTime(fecha.Year, fecha.Month, fecha.Day, ini.Hours, ini.Minutes >= 30 ? 30 : 0, 0);
            if (iniAjustado < gridInicio)
            {
                gridInicio = iniAjustado;
            }

            int finMin = fin.Minutes > 30 ? 60 : (fin.Minutes > 0 ? 30 : 0);
            var finAjustado = new DateTime(fecha.Year, fecha.Month, fecha.Day, fin.Hours, 0, 0).AddMinutes(finMin);
            if (finAjustado > gridFin)
            {
                gridFin = finAjustado;
            }
        }
    }

    Func<DateTime, bool> EnHorario = (fs) =>
    {
        if (rangosDia == null || rangosDia.Count == 0)
            return false;
        var fe = fs.AddMinutes(30);
        foreach (var r in rangosDia)
        {
            TimeSpan ini, fin;
if (!TimeSpan.TryParse(r.Inicio, out ini) || !TimeSpan.TryParse(r.Fin, out fin))
                {
                    continue;
                }
            if (fs.TimeOfDay < fin && fe.TimeOfDay > ini)
                return true;
        }
        return false;
    };

    int index = 0;
}

@if (recursos.Count == 0)
{
    @Html.Partial("~/Views/Shared/Components/_EmptyState.cshtml",
        new ViewDataDictionary {
            { "Icon", "collection" },
            { "Title", "Necesitas agregar al menos un recurso" },
            { "Description", "Sin recursos no puedes reservar turnos. Crea tu primer recurso para comenzar." },
            { "ActionText", "Crear Recurso" },
            { "ActionUrl", Url.Action("Create", "Recursos") }
        })
}
else
{
    <div class="jk-agenda-mobile" role="list" aria-label="Agenda por recurso">
        @foreach (var rec in recursos)
        {
            var turnosRec = turnos.Where(t => t.RecursoId == rec.Id).OrderBy(t => t.FechaHoraInicio).ToList();

            // D-046: bloques de indisponibilidad visibles de este recurso en el dia.
            var bloqueosRec = new List<JKTurnos.Models.Entities.BloqueoRecurso>();
            if (Model.Bloqueos != null)
            {
                foreach (var b in Model.Bloqueos)
                {
                    if (b.RecursoId != rec.Id) { continue; }
                    bool aplicaDia = false;
                    switch (b.Tipo)
                    {
                        case JKTurnos.Models.Entities.TipoBloqueo.Unico:
                            aplicaDia = b.FechaInicio.Date == fecha.Date;
                            break;
                        case JKTurnos.Models.Entities.TipoBloqueo.RangoFechas:
                            var bFin = b.FechaFin.HasValue ? b.FechaFin.Value.Date : b.FechaInicio.Date;
                            aplicaDia = fecha.Date >= b.FechaInicio.Date && fecha.Date <= bFin;
                            break;
                        default:
                            aplicaDia = fecha.DayOfWeek == b.FechaInicio.DayOfWeek;
                            break;
                    }
                    if (aplicaDia) { bloqueosRec.Add(b); }
                }
            }

            // Horarios libres: franjas de 30 min desocupadas, fusionadas en rangos continuos.
            var libres = new List<Tuple<DateTime, DateTime>>();
            DateTime franjaStart = gridInicio;
            DateTime? rangoStart = null;
            while (franjaStart < gridFin)
            {
                var franjaEnd = franjaStart.AddMinutes(30);
                bool ocupada = !EnHorario(franjaStart)
                    || turnosRec.Any(t => t.FechaHoraInicio < franjaEnd && t.FechaHoraFin > franjaStart)
                    || bloqueosRec.Any(b => FranjaBloqueada(b, franjaStart, franjaEnd));
                if (!ocupada)
                {
                    if (rangoStart == null)
                    {
                        rangoStart = franjaStart;
                    }
                }
                else if (rangoStart != null)
                {
                    libres.Add(Tuple.Create(rangoStart.Value, franjaStart));
                    rangoStart = null;
                }
                franjaStart = franjaEnd;
            }
            if (rangoStart != null)
            {
                libres.Add(Tuple.Create(rangoStart.Value, gridFin));
            }

            <details class="jk-agenda-mobile-resource" data-recurso-id="@rec.Id" style="--jk-block-color: @(rec.Color ?? "#7295B5");" @(rec.Id == Model.OpenRecursoId ? "open" : "")>
                <summary class="jk-agenda-mobile-resource-header" role="button" aria-label="@rec.Nombre, @turnosRec.Count turnos">
                    <span class="jk-agenda-resource-dot" style="background-color: @(rec.Color ?? "#7295B5");"></span>
                    <span class="jk-agenda-mobile-resource-name">@rec.Nombre</span>
                    <span class="jk-agenda-mobile-resource-count" aria-hidden="true">@turnosRec.Count</span>
                    <i class="bi bi-chevron-down jk-agenda-mobile-resource-chevron" aria-hidden="true"></i>
                </summary>
                <div class="jk-agenda-mobile-resource-body">
                    @if (turnosRec.Count == 0)
                    {
                        <p class="jk-agenda-mobile-empty">Sin turnos por el momento</p>
                    }
                    else
                    {
                        foreach (var t in turnosRec)
                        {
                            var clienteNombre = t.Cliente != null ? t.Cliente.Nombre : "Sin cliente";
                            var servicioNombre = t.Servicio != null ? t.Servicio.Nombre : "Reservado";
                            var estadoNombre = t.EstadoTurno != null ? t.EstadoTurno.Nombre : "";
                            var estadoIcono = t.EstadoTurno != null ? t.EstadoTurno.Icono : "bi-circle-fill";
                            var situacionClave = SituacionTemporal.Calcular(t);
                            var situacionAlarma = situacionClave != null && SituacionTemporal.EsAlarma(situacionClave) ? SituacionTemporal.De(situacionClave) : null;

                            <div class="jk-agenda-time-block"
                                 role="button"
                                 tabindex="0"
                                 data-turno-id="@t.Id"
                                 style="--jk-block-color: @(rec.Color ?? "#7295B5");"
                                 aria-label="Turno de @clienteNombre, @servicioNombre, @estadoNombre, @t.FechaHoraInicio.ToString("HH:mm")">
                                <div class="jk-agenda-time-block-band">
                                    <span class="jk-agenda-time-block-hour">@t.FechaHoraInicio.ToString("HH:mm") - @t.FechaHoraFin.ToString("HH:mm")</span>
                                    <button type="button" class="jk-agenda-time-block-pago" data-turno-id="@t.Id" title="Registrar pago" aria-label="Registrar pago de @clienteNombre">
                                        <i class="bi bi-cash-coin"></i>
                                    </button>
                                </div>
                                <div class="jk-agenda-time-block-body">
                                    <div class="jk-agenda-time-block-title">
                                        <span class="jk-agenda-time-block-status" title="@estadoNombre"><i class="bi @estadoIcono"></i></span>
                                        @if (situacionAlarma != null)
                                        {
                                            <span class="jk-agenda-time-block-status" title="@situacionAlarma.Label" style="color: @situacionAlarma.Color"><i class="bi @situacionAlarma.Icono"></i></span>
                                        }
                                        <span class="jk-agenda-time-block-client">@clienteNombre</span>
                                    </div>
                                    <span class="jk-agenda-time-block-service">@servicioNombre</span>
                                </div>
                            </div>
                        }
                    }

                    @if (bloqueosRec.Count > 0)
                    {
                        <div class="jk-bloqueo-mobile-list" role="list" aria-label="Bloqueos de disponibilidad">
                            @foreach (var b in bloqueosRec)
                            {
                                string bLabel = !string.IsNullOrWhiteSpace(b.Descripcion) ? b.Descripcion : "No disponible";
                                string bBand = "Todo el dia";
                                if (b.HoraInicio.HasValue && b.HoraFin.HasValue)
                                {
                                    bBand = b.HoraInicio.Value.ToString("hh\\:mm") + " - " + b.HoraFin.Value.ToString("hh\\:mm");
                                }
                                <div class="jk-bloqueo-recurso-mobile" role="status" aria-label="Bloqueo: @bLabel">
                                    <i class="bi bi-calendar-x" aria-hidden="true"></i>
                                    <div>
                                        <div class="jk-bloqueo-recurso-mobile-band">@bBand</div>
                                        <div class="jk-bloqueo-recurso-mobile-label">@bLabel</div>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    @if (libres.Count > 0)
                    {
                        <div class="jk-agenda-mobile-free-list" role="list" aria-label="Horarios libres">
                            @foreach (var libre in libres)
                            {
                                <button type="button"
                                        class="jk-agenda-mobile-free-slot"
                                        role="listitem"
                                        data-hora="@libre.Item1.ToString("HH:mm")"
                                        data-recurso-id="@rec.Id"
                                        title="Reservar turno @libre.Item1.ToString("HH:mm")">
                                    Libre @libre.Item1.ToString("HH:mm") - @libre.Item2.ToString("HH:mm")
                                </button>
                            }
                        </div>
                    }
                </div>
            </details>

            index++;
        }
    </div>
}