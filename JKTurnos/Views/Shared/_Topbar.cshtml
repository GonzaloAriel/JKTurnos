<header id="topbar" class="jk-topbar">
    <div class="jk-topbar-left">
        <button class="jk-topbar-toggle d-xl-none"
                id="mobile-menu-toggle"
                type="button"
                aria-label="Abrir menu"
                aria-controls="sidebar"
                aria-expanded="false">
            <i class="bi bi-list"></i>
        </button>
        <span class="jk-topbar-title">JKTurnos</span>
    </div>

    <div class="jk-search jk-search-global" id="jk-search-global">
        <form action="@Url.Action("Index", "Busqueda")" method="get" role="search" aria-label="Busqueda global">
            <i class="bi bi-search"></i>
            <input type="text"
                   id="jk-search-global-input"
                   name="termino"
                   placeholder="Buscar clientes, turnos, servicios..."
                   autocomplete="off"
                   aria-label="Busqueda global"
                   data-buscar-global-url="@Url.Action("Buscar", "Busqueda")" />
            @Html.AntiForgeryToken()
        </form>
        <div class="jk-autocomplete dropdown-menu" id="jk-search-global-results" aria-hidden="true"></div>
    </div>

    <div class="jk-topbar-right">
        @if (User.Identity.IsAuthenticated)
        {
            var recordatorios = ViewBag.TopbarRecordatorios != null
                ? (List<JKTurnos.Models.ViewModels.RecordatorioSistema>)ViewBag.TopbarRecordatorios
                : new List<JKTurnos.Models.ViewModels.RecordatorioSistema>();

            <div class="jk-topbar-notif" id="topbar-notif">
                @Html.AntiForgeryToken()
                <button class="jk-btn-icon jk-topbar-notif-toggle"
                        id="topbar-notif-toggle"
                        type="button"
                        aria-label="Notificaciones"
                        aria-expanded="false"
                        aria-controls="topbar-notif-panel">
                    <i class="bi bi-bell"></i>
                    @if (recordatorios.Count > 0)
                    {
                        <span class="jk-notif-badge" id="topbar-notif-badge">@recordatorios.Count</span>
                    }
                </button>
                <div class="jk-notif-panel" id="topbar-notif-panel" aria-hidden="true">
                    <div class="jk-notif-header">
                        <span class="jk-notif-header-title">Notificaciones</span>
                        <button type="button"
                                class="jk-notif-markread"
                                id="topbar-notif-markread"
                                data-marcar-notif
                                data-marcar-notif-url="@Url.Action("MarcarTodasLeidas", "Notificaciones")"
                                @(recordatorios.Count == 0 ? "disabled" : "")>
                            Marcar todas leidas
                        </button>
                    </div>
                    <div class="jk-notif-list">
                        @if (recordatorios.Count > 0)
                        {
                            <div id="topbar-recordatorios-section">
                                <div class="jk-notif-section-title">Recordatorios</div>
                                @Html.Partial("~/Views/Shared/Components/_RecordatoriosFeed.cshtml")
                            </div>
                        }
                        else
                        {
                            <div class="jk-notif-empty">No hay recordatorios pendientes</div>
                        }
                    </div>
                </div>
            </div>
        }
        <div class="jk-topbar-user" id="topbar-user-menu">
            <button type="button"
                    class="jk-topbar-user-toggle"
                    id="topbar-user-toggle"
                    aria-label="Menu de usuario"
                    aria-expanded="false"
                    aria-controls="topbar-user-panel">
                <span class="jk-avatar">
                    @{
                        string name = User.Identity.Name;
                        string initial = !string.IsNullOrEmpty(name) ? name.Substring(0, 1).ToUpper() : "?";
                    }
                    @initial
                </span>
                <span class="jk-topbar-username">@(name ?? "Usuario")</span>
                <i class="bi bi-chevron-down jk-topbar-user-caret"></i>
            </button>
            <div class="jk-user-panel" id="topbar-user-panel" aria-hidden="true">
                <div class="jk-user-panel-header">
                    <span class="jk-user-panel-name">@(name ?? "Usuario")</span>
                </div>
                <div class="jk-user-panel-menu">
                    <a href="@Url.Action("Index", "Ayuda")" class="jk-user-panel-item">
                        <i class="bi bi-question-circle"></i>
                        <span>Ayuda</span>
                    </a>
                    <form action="@Url.Action("Logout", "Account")"
                          method="post"
                          class="jk-user-panel-form"
                          data-jk-logout-form>
                        @Html.AntiForgeryToken()
                        <button type="submit" class="jk-user-panel-item jk-user-panel-logout">
                            <i class="bi bi-box-arrow-left"></i>
                            <span>Cerrar Sesion</span>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</header>
