<header id="topbar" class="jk-topbar">
    <div class="jk-topbar-left">
        <button class="jk-topbar-toggle d-xl-none"
                id="mobile-menu-toggle"
                type="button"
                aria-label="Abrir menu"
                aria-controls="sidebar"
                aria-expanded="false">
            <i class="bi bi-list"></i>
        </button>
        <span class="jk-topbar-title">JKTurnos</span>
    </div>

    <div class="jk-topbar-right">
        <button class="jk-btn-icon" aria-label="Notificaciones">
            <i class="bi bi-bell"></i>
        </button>
        <div class="jk-topbar-user">
            <div class="jk-avatar">
                @{
                    string name = User.Identity.Name;
                    string initial = !string.IsNullOrEmpty(name) ? name.Substring(0, 1).ToUpper() : "?";
                }
                @initial
            </div>
            <span class="jk-topbar-username">@(name ?? "Usuario")</span>
        </div>
    </div>
</header>
