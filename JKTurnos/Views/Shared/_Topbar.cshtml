<header id="topbar" class="jk-card" style="border-radius: 0; border-top: none; border-left: none; border-right: none; height: 64px; padding: 0 24px; display: flex; align-items: center; justify-content: space-between; z-index: 10;">
    <div class="d-flex align-items-center">
        <!-- Botón menú mobile (visible solo en mobile) -->
        <button class="jk-btn jk-btn-ghost d-lg-none me-2" id="mobile-menu-toggle">
            <i class="bi bi-list fs-4"></i>
        </button>
        <span class="jk-h3 mb-0 d-none d-sm-inline-block">JKTurnos</span>
        <span class="jk-h3 mb-0 d-sm-none">JK</span>
    </div>

    <div class="d-flex align-items-center gap-3">
        <button class="jk-btn jk-btn-ghost p-2">
            <i class="bi bi-bell fs-5"></i>
        </button>
        <div class="user-profile d-flex align-items-center gap-2 ps-3" style="border-left: 1px solid var(--jk-border);">
            <div class="avatar-circle" style="width: 32px; height: 32px; background: var(--jk-accent); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-weight: 600; font-size: 0.8rem;">
                @{
                    string name = User.Identity.Name;
                    string initial = !string.IsNullOrEmpty(name) ? name.Substring(0, 1).ToUpper() : "?";
                }
                @initial
            </div>
            <span class="jk-small fw-600 d-none d-md-inline-block">@(name ?? "Usuario")</span>
        </div>
    </div>
</header>
