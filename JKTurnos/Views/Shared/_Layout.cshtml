<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>@ViewBag.Title - JKTurnos</title>
    
    <!-- Fonts & Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    @Styles.Render("~/Content/css")
    
    <!-- JK Design System v1 (existing, will be phased out) -->
    <link href="~/Content/jk-components.css" rel="stylesheet" />
    <link href="~/Content/jk-layout.css" rel="stylesheet" />
    <link href="~/Content/jk-dashboard.css" rel="stylesheet" />

    <!-- JK Design System v2 (progressive migration) -->
    <link href="~/Content/DesignSystem/jk-tokens.css" rel="stylesheet" />
    <link href="~/Content/DesignSystem/jk-base.css" rel="stylesheet" />
    <link href="~/Content/DesignSystem/jk-layout.css" rel="stylesheet" />
    <link href="~/Content/DesignSystem/jk-components.css" rel="stylesheet" />
    <link href="~/Content/DesignSystem/jk-utilities.css" rel="stylesheet" />

    <!-- Page-specific styles -->
    @if (IsSectionDefined("PageStyles"))
    {
        @RenderSection("PageStyles", required: false)
    }
</head>
<body>
    <div class="app-container jk-app-shell" id="app-container">
        @if (User.Identity.IsAuthenticated)
        {
            @Html.Partial("_Sidebar")
            <div class="jk-sidebar-overlay" id="sidebar-overlay" aria-hidden="true"></div>
        }
        
        <div id="main-content">
            @if (User.Identity.IsAuthenticated)
            {
                @Html.Partial("_Topbar")
            }
            
            <main class="content-area jk-content-zone">
                @RenderBody()
            </main>
        </div>
    </div>

    @Html.Partial("~/Views/Shared/Components/_Toast.cshtml", new ViewDataDictionary { { "Id", "jk-toast-global" } })

    <div class="jk-drawer-backdrop" id="drawer-turno-global-backdrop"></div>
    <div class="jk-drawer" id="drawer-turno-global" role="dialog" aria-modal="true" aria-hidden="true" aria-labelledby="drawer-turno-global-title"
         data-turno-detail-url="@Url.Action("GetDetailDrawer", "Turnos")"
         data-registrar-pago-url="@Url.Action("RegistrarPago", "Turnos")"
         data-toast-id="jk-toast-global">
        <div class="jk-drawer-header">
            <h3 class="jk-drawer-title" id="drawer-turno-global-title">Detalle del turno</h3>
            <button type="button" class="jk-drawer-close" id="drawer-turno-global-close" aria-label="Cerrar">
                <i class="bi bi-x"></i>
            </button>
        </div>
        <div class="jk-drawer-body" id="drawer-turno-global-body"></div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    <script src="~/Scripts/jk-layout.js"></script>
    <script src="~/Scripts/jk-turnos-drawer.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
