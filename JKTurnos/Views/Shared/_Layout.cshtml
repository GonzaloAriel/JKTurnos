<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>@ViewBag.Title - JKTurnos</title>
    
    <!-- Fonts & Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    @Styles.Render("~/Content/css")
    
    <!-- JK Design System v1 (existing, will be phased out) -->
    <link href="~/Content/jk-components.css" rel="stylesheet" />
    <link href="~/Content/jk-layout.css" rel="stylesheet" />
    <link href="~/Content/jk-dashboard.css" rel="stylesheet" />

    <!-- JK Design System v2 (progressive migration) -->
    <link href="~/Content/DesignSystem/jk-tokens.css" rel="stylesheet" />
    <link href="~/Content/DesignSystem/jk-base.css" rel="stylesheet" />
    <link href="~/Content/DesignSystem/jk-layout.css" rel="stylesheet" />
    <link href="~/Content/DesignSystem/jk-components.css" rel="stylesheet" />
    <link href="~/Content/DesignSystem/jk-utilities.css" rel="stylesheet" />

    <!-- Page-specific styles -->
    @if (IsSectionDefined("PageStyles"))
    {
        @RenderSection("PageStyles", required: false)
    }
</head>
<body>
    <div class="app-container jk-app-shell" id="app-container">
        @Html.Partial("_Sidebar")
        
        <div class="jk-sidebar-overlay" id="sidebar-overlay" aria-hidden="true"></div>
        
        <div id="main-content">
            @Html.Partial("_Topbar")
            
            <main class="content-area jk-content-zone">
                @RenderBody()
            </main>
        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    <script src="~/Scripts/jk-layout.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
