<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>@ViewBag.Title - JKTurnos</title>
    
    <!-- Fonts & Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    @Styles.Render("~/Content/css")
    
    <!-- JK Design System -->
    <link href="~/Content/jk-components.css" rel="stylesheet" />
    <link href="~/Content/jk-layout.css" rel="stylesheet" />
    <link href="~/Content/jk-dashboard.css" rel="stylesheet" />
</head>
<body>
    <div class="app-container">
        @Html.Partial("_Sidebar")
        
        <div id="main-content">
            @Html.Partial("_Topbar")
            
            <main class="content-area">
                @RenderBody()
            </main>
        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    <script src="~/Scripts/jk-layout.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
