@model List<JKTurnos.Models.Entities.EstadoTurno>

@using JKTurnos.Models.Entities
@using JKTurnos.Models.ViewModels

@{
    ViewBag.Title = "Configuracion";
    ViewBag.Subtitle = "Ajusta los datos y el funcionamiento de tu negocio";

    var config = ViewBag.Configuracion as JKTurnos.Models.Entities.ConfiguracionTenant;
    var suscripcion = ViewBag.Suscripcion as SuscripcionTenantViewModel;
    var pagos = ViewBag.PagosSuscripcion as List<JKTurnos.Models.Entities.PagoSuscripcion>;
}

@Html.Partial("~/Views/Shared/Components/_PageHeader.cshtml")

<!-- ===== SUSCRIPCION (AG-5) ===== -->
<div class="jk-card jk-mt-24">
    <div class="jk-card-header">
        <h3 class="jk-card-title">Suscripcion</h3>
        @if (suscripcion != null)
        {
            @Html.Partial("~/Views/Shared/Components/_BadgeEstadoSuscripcion.cshtml", suscripcion.Estado)
        }
    </div>

    @if (suscripcion != null && !string.IsNullOrEmpty(suscripcion.PlanCodigo))
    {
        <div class="jk-grid">
            <div class="jk-col-4">
                <p class="jk-small text-secondary jk-mb-0">Plan actual</p>
                <p class="jk-mt-4">
                    @(suscripcion.PlanNombre ?? suscripcion.PlanCodigo)
                    @if (suscripcion.SuspendidoManual)
                    {
                        <text> · suspendido manualmente</text>
                    }
                </p>
            </div>
            <div class="jk-col-4">
                <p class="jk-small text-secondary jk-mb-0">Inicio</p>
                <p class="jk-mt-4">@(suscripcion.FechaInicioPeriodo.HasValue ? suscripcion.FechaInicioPeriodo.Value.ToString("dd/MM/yyyy") : "-")</p>
            </div>
            <div class="jk-col-4">
                <p class="jk-small text-secondary jk-mb-0">Vencimiento</p>
                <p class="jk-mt-4">@(suscripcion.FechaVencimiento.HasValue ? suscripcion.FechaVencimiento.Value.ToString("dd/MM/yyyy") : "-")</p>
            </div>
            <div class="jk-col-4">
                <p class="jk-small text-secondary jk-mb-0">Tiempo restante</p>
                <p class="jk-mt-4">@suscripcion.TiempoRestanteTexto</p>
            </div>
        </div>
    }
    else if (suscripcion != null)
    {
        <p class="jk-small text-secondary jk-mb-0">
            Tu negocio todavia no tiene una suscripcion asignada.
            @(suscripcion.SuspendidoManual ? "Ademas, la cuenta esta suspendida manualmente." : "")
        </p>
    }
</div>

<!-- ===== HISTORIAL DE PAGOS (AG-8) ===== -->
<div class="jk-card jk-mt-24">
    <div class="jk-card-header">
        <h3 class="jk-card-title">Historial de pagos</h3>
    </div>

    @if (pagos != null && pagos.Any())
    {
        <div class="jk-hide-mobile">
            <div class="jk-table-wrap">
                <table class="jk-table">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Plan</th>
                            <th>Monto</th>
                            <th>Observacion</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pago in pagos)
                        {
                            var plan = PlanesSuscripcion.Obtener(pago.PlanCodigo);
                            <tr>
                                <td>@pago.Fecha.ToString("dd/MM/yyyy")</td>
                                <td>@plan.Nombre</td>
                                <td>$@pago.Monto.ToString("N2")</td>
                                <td>@(string.IsNullOrWhiteSpace(pago.Observacion) ? "-" : pago.Observacion)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="jk-show-mobile jk-flex jk-flex-col jk-gap-12">
            @foreach (var pago in pagos)
            {
                var plan = PlanesSuscripcion.Obtener(pago.PlanCodigo);
                <div class="jk-card jk-card-compact">
                    <div class="jk-flex-between">
                        <strong>@plan.Nombre</strong>
                        <span class="jk-small text-secondary">@pago.Fecha.ToString("dd/MM/yyyy")</span>
                    </div>
                    <div class="jk-mt-4 jk-small">
                        $@pago.Monto.ToString("N2")
                        @if (!string.IsNullOrWhiteSpace(pago.Observacion))
                        {
                            <text> · @pago.Observacion</text>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p class="jk-small text-secondary jk-mb-0">
            No hay pagos de suscripcion registrados para tu negocio.
        </p>
    }
</div>

<!-- ===== DATOS DEL NEGOCIO ===== -->
<div class="jk-card jk-mt-24">
    <div class="jk-card-header">
        <h3 class="jk-card-title">Datos del negocio</h3>
        <a href="@Url.Action("DatosNegocio")" class="jk-btn jk-btn-sm jk-btn-ghost">
            <i class="bi bi-pencil"></i> Editar
        </a>
    </div>

    @if (config != null && !string.IsNullOrWhiteSpace(config.NombreComercial))
    {
        <div class="jk-grid">
            <div class="jk-col-4">
                <p class="jk-small text-secondary jk-mb-0">Nombre comercial</p>
                <p class="jk-mt-4">@config.NombreComercial</p>
            </div>
            <div class="jk-col-4">
                <p class="jk-small text-secondary jk-mb-0">Telefono</p>
                <p class="jk-mt-4">@(string.IsNullOrWhiteSpace(config.Telefono) ? "-" : config.Telefono)</p>
            </div>
            <div class="jk-col-4">
                <p class="jk-small text-secondary jk-mb-0">Email de contacto</p>
                <p class="jk-mt-4">@(string.IsNullOrWhiteSpace(config.Email) ? "-" : config.Email)</p>
            </div>
            <div class="jk-col-4">
                <p class="jk-small text-secondary jk-mb-0">Direccion</p>
                <p class="jk-mt-4">@(string.IsNullOrWhiteSpace(config.Direccion) ? "-" : config.Direccion)</p>
            </div>
            <div class="jk-col-4">
                <p class="jk-small text-secondary jk-mb-0">Logo</p>
                <p class="jk-mt-4">@(string.IsNullOrWhiteSpace(config.LogoUrl) ? "-" : config.LogoUrl)</p>
            </div>
        </div>
    }
    else
    {
        <p class="jk-small text-secondary jk-mb-0">Todavia no cargaste los datos de tu negocio. Cargalos con el boton Editar.</p>
    }
</div>

<!-- ===== CONFIGURACION DE NOTIFICACIONES ===== -->
<div class="jk-card jk-mt-24">
    <div class="jk-card-header">
        <h3 class="jk-card-title">Configuracion de notificaciones</h3>
        <a href="@Url.Action("Notificaciones")" class="jk-btn jk-btn-sm jk-btn-ghost">
            <i class="bi bi-arrow-right"></i> Ver seccion
        </a>
    </div>

    @if (config != null)
    {
        <div>
            <div class="jk-flex-between jk-list-row">
                <div class="jk-col-9">
                    <p class="jk-small text-secondary jk-mb-0">Recordatorio por WhatsApp</p>
                    <p class="jk-mt-4 jk-small">
                        @(string.IsNullOrWhiteSpace(config.WhatsAppTemplate)
                            ? "Plantilla por defecto."
                            : "Plantilla configurada.")
                    </p>
                </div>
                <span class="jk-flex jk-gap-8">
                    <a href="@Url.Action("NotificacionesWhatsApp")" class="jk-btn jk-btn-icon" title="Editar WhatsApp">
                        <i class="bi bi-pencil"></i>
                    </a>
                </span>
            </div>

            <div class="jk-flex-between jk-list-row">
                <div class="jk-col-9">
                    <p class="jk-small text-secondary jk-mb-0">Recordatorio por email (SMTP)</p>
                    <p class="jk-mt-4 jk-small">
                        @if (config.SmtpHabilitado)
                        {
                            <text>Habilitado@(!string.IsNullOrWhiteSpace(config.SmtpServidor) ? " · " + config.SmtpServidor : "")</text>
                        }
                        else
                        {
                            <text>No habilitado.</text>
                        }
                    </p>
                </div>
                <span class="jk-flex jk-gap-8">
                    <a href="@Url.Action("NotificacionesEmail")" class="jk-btn jk-btn-icon" title="Editar email">
                        <i class="bi bi-pencil"></i>
                    </a>
                </span>
            </div>
        </div>
    }
    else
    {
        <p class="jk-small text-secondary jk-mb-0">Carga los datos del negocio para configurar los recordatorios.</p>
    }
</div>

<!-- ===== ESTADOS DE TURNO ===== -->
<div class="jk-card jk-mt-24">
    <div class="jk-card-header">
        <h3 class="jk-card-title">Estados de turno</h3>
        <a href="@Url.Action("EstadoCrear")" class="jk-btn jk-btn-sm jk-btn-primary">
            <i class="bi bi-plus-lg"></i> Nuevo Estado
        </a>
    </div>

    @if (Model.Any())
    {
        <div>
            @foreach (var estado in Model)
            {
                <div class="jk-flex-between jk-list-row">
                    <span class="jk-flex jk-gap-8">
                        <span class="jk-color-dot" style="background-color:@estado.Color"></span>
                        @estado.Nombre
                    </span>
                    <span class="jk-flex jk-gap-8">
                        <a href="@Url.Action("EstadoEditar", new { id = estado.Id })" class="jk-btn jk-btn-icon" title="Editar">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a href="@Url.Action("EstadoEliminar", new { id = estado.Id })" class="jk-btn jk-btn-icon" title="Eliminar">
                            <i class="bi bi-trash"></i>
                        </a>
                    </span>
                </div>
            }
        </div>
    }
    else
    {
        <p class="jk-small text-secondary jk-mb-0">No tenes estados de turno. Agrega el primero con "Nuevo Estado".</p>
    }
</div>