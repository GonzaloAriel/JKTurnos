@using JKTurnos.Models.Entities

@{
    ViewBag.Title = "Configuracion";
    ViewBag.Subtitle = "Ajusta los datos y el funcionamiento de tu negocio";

    var config = ViewBag.Configuracion as JKTurnos.Models.Entities.ConfiguracionTenant;
}

@Html.Partial("~/Views/Shared/Components/_PageHeader.cshtml")

<!-- ===== SUSCRIPCION Y PAGOS ===== -->
<div class="jk-card jk-mt-24">
    <div class="jk-card-header">
        <h3 class="jk-card-title">Suscripcion y pagos</h3>
        <a href="@Url.Action("Suscripcion")" class="jk-btn jk-btn-sm jk-btn-ghost">
            <i class="bi bi-arrow-right"></i> Ver seccion
        </a>
    </div>
    <p class="jk-small text-secondary jk-mb-0">
        Consulta el estado de tu suscripcion, plan asignado e historial de pagos.
    </p>
</div>

<!-- ===== DATOS DEL NEGOCIO ===== -->
<div class="jk-card jk-mt-24">
    <div class="jk-card-header">
        <h3 class="jk-card-title">Datos del negocio</h3>
        <a href="@Url.Action("DatosNegocio")" class="jk-btn jk-btn-sm jk-btn-ghost">
            <i class="bi bi-pencil"></i> Editar
        </a>
    </div>

    @if (config != null && !string.IsNullOrWhiteSpace(config.NombreComercial))
    {
        <div class="jk-grid">
            <div class="jk-col-4">
                <p class="jk-small text-secondary jk-mb-0">Nombre comercial</p>
                <p class="jk-mt-4">@config.NombreComercial</p>
            </div>
            <div class="jk-col-4">
                <p class="jk-small text-secondary jk-mb-0">Telefono</p>
                <p class="jk-mt-4">@(string.IsNullOrWhiteSpace(config.Telefono) ? "-" : config.Telefono)</p>
            </div>
            <div class="jk-col-4">
                <p class="jk-small text-secondary jk-mb-0">Email de contacto</p>
                <p class="jk-mt-4">@(string.IsNullOrWhiteSpace(config.Email) ? "-" : config.Email)</p>
            </div>
            <div class="jk-col-4">
                <p class="jk-small text-secondary jk-mb-0">Direccion</p>
                <p class="jk-mt-4">@(string.IsNullOrWhiteSpace(config.Direccion) ? "-" : config.Direccion)</p>
            </div>
            <div class="jk-col-4">
                <p class="jk-small text-secondary jk-mb-0">Logo</p>
                <p class="jk-mt-4">@(string.IsNullOrWhiteSpace(config.LogoUrl) ? "-" : config.LogoUrl)</p>
            </div>
        </div>
    }
    else
    {
        <p class="jk-small text-secondary jk-mb-0">Todavia no cargaste los datos de tu negocio. Cargalos con el boton Editar.</p>
    }
</div>

<!-- ===== CONFIGURACION DE NOTIFICACIONES ===== -->
<div class="jk-card jk-mt-24">
    <div class="jk-card-header">
        <h3 class="jk-card-title">Configuracion de notificaciones</h3>
        <a href="@Url.Action("Notificaciones")" class="jk-btn jk-btn-sm jk-btn-ghost">
            <i class="bi bi-arrow-right"></i> Ver seccion
        </a>
    </div>

    @if (config != null)
    {
        <div>
            <div class="jk-flex-between jk-list-row">
                <div class="jk-col-9">
                    <p class="jk-small text-secondary jk-mb-0">Recordatorio por WhatsApp</p>
                    <p class="jk-mt-4 jk-small">
                        @(string.IsNullOrWhiteSpace(config.WhatsAppTemplate)
                            ? "Plantilla por defecto."
                            : "Plantilla configurada.")
                    </p>
                </div>
                <span class="jk-flex jk-gap-8">
                    <a href="@Url.Action("NotificacionesWhatsApp")" class="jk-btn jk-btn-icon" title="Editar WhatsApp">
                        <i class="bi bi-pencil"></i>
                    </a>
                </span>
            </div>

            <div class="jk-flex-between jk-list-row">
                <div class="jk-col-9">
                    <p class="jk-small text-secondary jk-mb-0">Recordatorio por email (SMTP)</p>
                    <p class="jk-mt-4 jk-small">
                        @if (config.SmtpHabilitado)
                        {
                            <text>Habilitado@(!string.IsNullOrWhiteSpace(config.SmtpServidor) ? " · " + config.SmtpServidor : "")</text>
                        }
                        else
                        {
                            <text>No habilitado.</text>
                        }
                    </p>
                </div>
                <span class="jk-flex jk-gap-8">
                    <a href="@Url.Action("NotificacionesEmail")" class="jk-btn jk-btn-icon" title="Editar email">
                        <i class="bi bi-pencil"></i>
                    </a>
                </span>
            </div>
        </div>
    }
    else
    {
        <p class="jk-small text-secondary jk-mb-0">Carga los datos del negocio para configurar los recordatorios.</p>
    }
</div>