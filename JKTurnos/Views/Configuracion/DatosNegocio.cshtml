@model JKTurnos.Models.Entities.ConfiguracionTenant

@helper FormContent()
{
    <div class="jk-form-group">
        <label class="jk-label" for="NombreComercial">Nombre comercial</label>
        @Html.TextBoxFor(m => m.NombreComercial, new { @class = "jk-input", placeholder = "Nombre de tu negocio", id = "NombreComercial" })
        @Html.ValidationMessageFor(m => m.NombreComercial, "", new { @class = "jk-field-error" })
    </div>

    <div class="jk-form-group">
        <label class="jk-label" for="Telefono">Telefono</label>
        @Html.TextBoxFor(m => m.Telefono, new { @class = "jk-input", placeholder = "ej: 351-555-1234", id = "Telefono" })
    </div>

    <div class="jk-form-group">
        <label class="jk-label" for="Email">Email de contacto</label>
        @Html.TextBoxFor(m => m.Email, new { @class = "jk-input", placeholder = "contacto@negocio.com", id = "Email" })
        <small class="jk-small text-secondary">Aparece en las comunicaciones con tus clientes.</small>
    </div>

    <div class="jk-form-group">
        <label class="jk-label" for="Direccion">Direccion</label>
        @Html.TextBoxFor(m => m.Direccion, new { @class = "jk-input", placeholder = "Calle y numero", id = "Direccion" })
    </div>

    <div class="jk-form-group">
        <label class="jk-label" for="AvatarUrl">Avatar</label>
        @{
            var avatares = ViewBag.Avatares as List<JKTurnos.Models.Entities.AvatarPlataforma> ?? new List<JKTurnos.Models.Entities.AvatarPlataforma>();
            var avatarItems = new List<System.Web.Mvc.SelectListItem> {
                new System.Web.Mvc.SelectListItem { Value = "", Text = "(Ninguno)" }
            };
            foreach (var a in avatares)
            {
                avatarItems.Add(new System.Web.Mvc.SelectListItem {
                    Value = a.Url,
                    Text = a.Nombre,
                    Selected = Model.AvatarUrl == a.Url
                });
            }
        }
        @Html.DropDownListFor(m => m.AvatarUrl, avatarItems, new { @class = "jk-input", id = "AvatarUrl" })
        <small class="jk-small text-secondary">Elegi un avatar de la plataforma. Se muestra en el menu lateral.</small>
    </div>

    <div class="jk-form-group">
        <label class="jk-label">Preview del avatar</label>
        <div id="avatarPreviewWrap" style="display:flex;align-items:center;gap:var(--jk-space-12);">
            <div id="avatarPreviewImgWrap" style="display:none;">
                <img id="avatarPreviewImg" src="" alt="Preview"
                     style="width:56px;height:56px;border-radius:50%;object-fit:cover;border:2px solid var(--jk-border-light);" />
            </div>
            <div id="avatarPreviewIcon" style="width:56px;height:56px;border-radius:50%;background:var(--jk-surface);border:2px dashed var(--jk-border-light);display:flex;align-items:center;justify-content:center;color:var(--jk-text-secondary);">
                <i class="bi bi-person" style="font-size:1.4rem;"></i>
            </div>
        </div>
    </div>

    <hr class="jk-mt-16 jk-mb-16" style="border:none;border-top:1px solid var(--jk-border-light);" />

    <div class="jk-form-group">
        <label class="jk-label" for="LogoUrl">Logo propio (URL)</label>
        @Html.TextBoxFor(m => m.LogoUrl, new { @class = "jk-input", placeholder = "https://tu-sitio.com/logo.png", id = "LogoUrl" })
        <small class="jk-small text-secondary">Se muestra en el menu lateral y en la bienvenida. Si elegiste un avatar, este campo se ignora.</small>
    </div>

    <div class="jk-note">
        <strong>Como subir tu logo gratis:</strong><br />
        1. Entra a un servicio de alojamiento de imagenes gratuito (por ejemplo postimages.org o imgbb.com).<br />
        2. Subi la imagen del logo y copia la URL directa (el enlace que termina en .png, .jpg o .gif).<br />
        3. Pegala en el campo de arriba y guarda.<br />
        Tamanio recomendado: 200x200 px (cuadrado), menor a 1MB.<br />
        Si la imagen no aparece, verifica que sea una URL directa y no un enlace a una pagina web.
    </div>

    <hr class="jk-mt-16 jk-mb-16" style="border:none;border-top:1px solid var(--jk-border-light);" />

    <div class="jk-form-group">
        @{
            // D-050: horario efectivo por dia (JSON -> legacy -> default Lun-Sab 08:00-19:30).
            // Se renderiza pre-cargado (como el viejo prefill 08:00/19:30) pero no se
            // persiste hasta que el usuario guarda la forma.
            var horarioDias = JKTurnos.Services.HorarioAtencionHelper.ResolverLista(Model);
            var horarioJson = JKTurnos.Services.HorarioAtencionHelper.Serializar(horarioDias);
            var diasNombreHorario = new[] { "Lun", "Mar", "Mie", "Jue", "Vie", "Sab", "Dom" };
            var rangosPorDia = new System.Collections.Generic.Dictionary<int, System.Collections.Generic.List<JKTurnos.Models.Entities.RangoAtencion>>();
            foreach (var hd in horarioDias)
            {
                rangosPorDia[hd.Dia] = hd.Rangos ?? new System.Collections.Generic.List<JKTurnos.Models.Entities.RangoAtencion>();
            }
        }

        <label class="jk-label">Horarios de atencion por dia</label>
        <div id="jkHorarioEditor" class="jk-horario-editor">
            @for (int n = 1; n <= 7; n++)
            {
                var tiene = rangosPorDia.ContainsKey(n) && rangosPorDia[n].Count > 0;
                var rangos = tiene
                    ? rangosPorDia[n]
                    : new System.Collections.Generic.List<JKTurnos.Models.Entities.RangoAtencion>
                    {
                        new JKTurnos.Models.Entities.RangoAtencion { Inicio = "", Fin = "" }
                    };
                var rangosStyle = tiene ? "" : "display:none";

                <div class="jk-horario-dia" data-dia="@n">
                    <div class="jk-horario-dia-head">
                        <label class="jk-horario-dia-label">
                            <input type="checkbox" class="jk-horario-check" @(tiene ? "checked" : "")
                                   style="accent-color:var(--jk-accent);" />
                            <span class="jk-horario-dia-nombre">@diasNombreHorario[n - 1]</span>
                        </label>
                    </div>
                    <div class="jk-horario-rangos" style="@rangosStyle">
                        @foreach (var r in rangos)
                        {
                            <div class="jk-horario-rango-row">
                                <input type="time" class="jk-input jk-horario-inicio" value="@r.Inicio" aria-label="Inicio" />
                                <span class="jk-horario-sep">a</span>
                                <input type="time" class="jk-input jk-horario-fin" value="@r.Fin" aria-label="Fin" />
                                <button type="button" class="jk-btn jk-btn-icon jk-horario-remove" title="Quitar franja" aria-label="Quitar franja">
                                    <i class="bi bi-x"></i>
                                </button>
                            </div>
                        }
                        <button type="button" class="jk-btn jk-btn-ghost jk-btn-sm jk-horario-add">+ Agregar franja</button>
                    </div>
                </div>
            }
        </div>
        <small class="jk-small text-secondary">
            Elegi en que dias y franjas horarias recibis atencion. Soporta turno
            partido (ej: de 8 a 12 y de 17 a 20). Este horario es informativo y no
            impide dar un turno mas alla del rango: se usa en la agenda, la vidriera
            publica y el calculo de ocupacion del dia.
        </small>
    </div>

    <input type="hidden" name="HorarioAtencion" id="HorarioAtencionHidden" value="@horarioJson" />

}



@{
    ViewBag.Title = "Datos del negocio";
    ViewBag.Subtitle = "Nombre, contacto y datos generales";
    ViewBag.SubmitText = "Guardar";
    ViewBag.CancelUrl = Url.Action("Index");

    ViewBag.FormContent = FormContent();
}

@Html.Partial("~/Views/Shared/Components/_FormLayout.cshtml")

<script>
    (function () {
        var ddl = document.getElementById('AvatarUrl');
        var imgWrap = document.getElementById('avatarPreviewImgWrap');
        var img = document.getElementById('avatarPreviewImg');
        var icon = document.getElementById('avatarPreviewIcon');

        function updatePreview() {
            var url = ddl.value;
            if (url) {
                img.src = url;
                img.onload = function () {
                    imgWrap.style.display = 'block';
                    icon.style.display = 'none';
                };
                img.onerror = function () {
                    imgWrap.style.display = 'none';
                    icon.style.display = 'flex';
                };
            } else {
                imgWrap.style.display = 'none';
                icon.style.display = 'flex';
            }
        }

        ddl.addEventListener('change', updatePreview);
        updatePreview();
    })();

    (function () {
        var hidden = document.getElementById('HorarioAtencionHidden');
        var editor = document.getElementById('jkHorarioEditor');

        function rebuild() {
            var out = [];
            var dias = editor.querySelectorAll('.jk-horario-dia');
            for (var i = 0; i < dias.length; i++) {
                var dayBox = dias[i];
                var check = dayBox.querySelector('.jk-horario-check');
                if (!check.checked) continue;

                var rangos = [];
                var rows = dayBox.querySelectorAll('.jk-horario-rango-row');
                for (var j = 0; j < rows.length; j++) {
                    var ini = rows[j].querySelector('.jk-horario-inicio').value;
                    var fin = rows[j].querySelector('.jk-horario-fin').value;
                    if (ini && fin) rangos.push({ Inicio: ini, Fin: fin });
                }

                if (rangos.length > 0) {
                    out.push({ Dia: parseInt(dayBox.getAttribute('data-dia'), 10), Rangos: rangos });
                }
            }
            hidden.value = JSON.stringify(out);
        }

        function attachRow(row, diaBox) {
            var inis = row.querySelectorAll('.jk-horario-inicio, .jk-horario-fin');
            for (var i = 0; i < inis.length; i++) {
                inis[i].addEventListener('change', rebuild);
                inis[i].addEventListener('input', rebuild);
            }
            row.querySelector('.jk-horario-remove').addEventListener('click', function () {
                row.remove();
                if (diaBox.querySelectorAll('.jk-horario-rango-row').length === 0) {
                    addRango(diaBox);
                }
                rebuild();
            });
        }

        function addRango(diaBox) {
            var container = diaBox.querySelector('.jk-horario-rangos');
            var row = document.createElement('div');
            row.className = 'jk-horario-rango-row';
            row.innerHTML =
                '<input type="time" class="jk-input jk-horario-inicio" aria-label="Inicio" />' +
                '<span class="jk-horario-sep">a</span>' +
                '<input type="time" class="jk-input jk-horario-fin" aria-label="Fin" />' +
                '<button type="button" class="jk-btn jk-btn-icon jk-horario-remove" title="Quitar franja" aria-label="Quitar franja"><i class="bi bi-x"></i></button>';
            container.insertBefore(row, container.querySelector('.jk-horario-add'));
            attachRow(row, diaBox);
            rebuild();
        }

        function toggleDay(diaBox) {
            var check = diaBox.querySelector('.jk-horario-check');
            var container = diaBox.querySelector('.jk-horario-rangos');
            if (check.checked) {
                container.style.display = '';
                if (container.querySelectorAll('.jk-horario-rango-row').length === 0) {
                    addRango(diaBox);
                }
            } else {
                container.style.display = 'none';
            }
            rebuild();
        }

        var dias = editor.querySelectorAll('.jk-horario-dia');
        for (var i = 0; i < dias.length; i++) {
            (function (diaBox) {
                diaBox.querySelector('.jk-horario-check').addEventListener('change', function () {
                    toggleDay(diaBox);
                });
                diaBox.querySelector('.jk-horario-add').addEventListener('click', function () {
                    addRango(diaBox);
                    toggleDay(diaBox);
                });
                var rows = diaBox.querySelectorAll('.jk-horario-rango-row');
                for (var k = 0; k < rows.length; k++) {
                    attachRow(rows[k], diaBox);
                }
            })(dias[i]);
        }
    })();
</script>

<style>
    .jk-horario-editor { display: flex; flex-direction: column; gap: 12px; }
    .jk-horario-dia { border: 1px solid var(--jk-border-light); border-radius: 8px; overflow: hidden; background: var(--jk-surface); }
    .jk-horario-dia-head { padding: 10px 14px; border-bottom: 1px solid var(--jk-border-light); }
    .jk-horario-dia-label { display: inline-flex; align-items: center; gap: 10px; cursor: pointer; font-weight: 600; font-size: var(--jk-text-sm); user-select: none; }
    .jk-horario-rangos { padding: 10px 14px; display: flex; flex-direction: column; gap: 8px; }
    .jk-horario-rango-row { display: flex; align-items: center; gap: 8px; }
    .jk-horario-rango-row .jk-input { flex: 1; min-width: 0; }
    .jk-horario-sep { color: var(--jk-text-secondary); font-size: var(--jk-text-sm); }
    .jk-horario-dia:not(:has(.jk-horario-check:checked)) { opacity: 0.55; }
</style>