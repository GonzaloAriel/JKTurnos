@model JKTurnos.Models.Entities.EstadoTurno

@{
    ViewBag.Title = "Eliminar Estado";
    ViewBag.Subtitle = "Confirma la baja del estado";
}

@Html.Partial("~/Views/Shared/Components/_PageHeader.cshtml")

<div class="jk-card jk-mt-24">
    <p>
        <span class="jk-color-dot" style="background-color:@Model.Color"></span>
        ¿Estas seguro que deseas eliminar el estado <strong>@Model.Nombre</strong>?
    </p>
    <p class="jk-small text-secondary jk-mt-8">Los turnos que ya usan este estado no se pierden.</p>

    @using (Html.BeginForm("EstadoEliminar", "Configuracion", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id)

        <div class="jk-flex jk-gap-12 jk-mt-16">
            <button type="submit" class="jk-btn jk-btn-danger">
                <i class="bi bi-trash"></i> Si, eliminar
            </button>
            <a href="@Url.Action("Index")" class="jk-btn jk-btn-ghost">
                Cancelar
            </a>
        </div>
    }
</div>