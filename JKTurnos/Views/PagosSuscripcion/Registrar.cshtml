@model JKTurnos.Models.ViewModels.RegistrarPagoViewModel

@helper FormContent() {
    <div class="jk-form-group">
        <label class="jk-label" for="@Html.IdFor(m => m.TenantId)">Tenant</label>
        @Html.DropDownListFor(m => m.TenantId,
            ViewBag.Tenants as SelectList,
            "Seleccione un tenant",
            new { @class = "jk-input", required = "required" })
        @Html.ValidationMessageFor(m => m.TenantId, "", new { @class = "jk-field-error" })
    </div>

    <div class="jk-form-group">
        <label class="jk-label" for="@Html.IdFor(m => m.PlanCodigo)">Plan</label>
        @Html.DropDownListFor(m => m.PlanCodigo,
            ViewBag.Planes as SelectList,
            "Seleccione un plan",
            new { @class = "jk-input", required = "required" })
        @Html.ValidationMessageFor(m => m.PlanCodigo, "", new { @class = "jk-field-error" })
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="jk-form-group">
                <label class="jk-label" for="@Html.IdFor(m => m.Monto)">Monto ($)</label>
                @Html.TextBoxFor(m => m.Monto, new { @class = "jk-input", type = "number", step = "0.01", min = "0", required = "required" })
                @Html.ValidationMessageFor(m => m.Monto, "", new { @class = "jk-field-error" })
            </div>
        </div>
        <div class="col-md-6">
            <div class="jk-form-group">
                <label class="jk-label" for="@Html.IdFor(m => m.Fecha)">Fecha</label>
                @Html.TextBoxFor(m => m.Fecha, "{0:yyyy-MM-dd}", new { @class = "jk-input", type = "date", required = "required" })
                @Html.ValidationMessageFor(m => m.Fecha, "", new { @class = "jk-field-error" })
            </div>
        </div>
    </div>

    <div class="jk-form-group">
        <label class="jk-label" for="@Html.IdFor(m => m.Observacion)">Observacion</label>
        @Html.TextAreaFor(m => m.Observacion, new { @class = "jk-input", maxlength = "500", rows = "3", placeholder = "Referencia, comprobante o nota (opcional)" })
        @Html.ValidationMessageFor(m => m.Observacion, "", new { @class = "jk-field-error" })
    </div>
}

@{
    ViewBag.Title = "Registrar Pago de Plataforma";
    ViewBag.Subtitle = "Registra un pago de suscripcion y actualiza la vigencia del tenant";
    ViewBag.SubmitText = "Registrar Pago";
    ViewBag.CancelUrl = Url.Action("Index");
    ViewBag.FormContent = FormContent();
}

@Html.Partial("~/Views/Shared/Components/_FormLayout.cshtml")
