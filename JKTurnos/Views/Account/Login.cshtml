@model JKTurnos.Models.ViewModels.LoginVM

@{
    ViewBag.Title = "Ingresar";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

<div class="jk-login-card-head">
    <h1>Bienvenido</h1>
    <p>Ingresa tus credenciales para continuar.</p>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="jk-form-error">
        @Html.ValidationSummary(true)
    </div>
}

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="jk-login-field">
        <label class="jk-label" for="Email">Email</label>
        @Html.TextBoxFor(
            x => x.Email,
            new { @class = "jk-input", placeholder = "tu@correo.com", autocomplete = "username" })
        @Html.ValidationMessageFor(x => x.Email, "", new { @class = "jk-field-error" })
    </div>

    <div class="jk-login-field">
        <label class="jk-label" for="Password">Contrasena</label>
        @Html.PasswordFor(
            x => x.Password,
            new { @class = "jk-input", placeholder = "••••••••", autocomplete = "current-password" })
        @Html.ValidationMessageFor(x => x.Password, "", new { @class = "jk-field-error" })
    </div>

    <button type="submit" class="jk-btn jk-btn-primary jk-login-submit">
        Ingresar
    </button>
}