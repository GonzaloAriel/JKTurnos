@model JKTurnos.Models.ViewModels.TurnoViewModel

@helper FormContent() {
    @Html.HiddenFor(m => m.Id)
    <div class="jk-form-group">
        <label class="jk-label" for="@Html.IdFor(m => m.ClienteId)">@Html.DisplayNameFor(m => m.ClienteId)</label>
        @Html.DropDownListFor(m => m.ClienteId, Model.Clientes, "Seleccione un cliente", new { @class = "jk-input" })
        @Html.ValidationMessageFor(m => m.ClienteId, "", new { @class = "jk-field-error" })
    </div>

    <div class="jk-form-group">
        <label class="jk-label" for="@Html.IdFor(m => m.ServicioId)">@Html.DisplayNameFor(m => m.ServicioId)</label>
        <div class="jk-flex jk-gap-8">
            @Html.DropDownListFor(m => m.ServicioId, Model.Servicios, "Seleccione un servicio (opcional)", new { @class = "jk-input jk-flex-1", id = "ServicioId" })
            <button type="button" class="jk-btn jk-btn-icon" data-jk-open-drawer="drawer-quick-servicio" title="Crear servicio" aria-label="Crear servicio">
                <i class="bi bi-plus-lg"></i>
            </button>
        </div>
        @Html.ValidationMessageFor(m => m.ServicioId, "", new { @class = "jk-field-error" })
    </div>

    <div class="jk-form-group">
        <label class="jk-label" for="@Html.IdFor(m => m.RecursoId)">@Html.DisplayNameFor(m => m.RecursoId)</label>
        <div class="jk-flex jk-gap-8">
            @Html.DropDownListFor(m => m.RecursoId, Model.Recursos, "Seleccione un recurso", new { @class = "jk-input jk-flex-1", id = "RecursoId" })
            <button type="button" class="jk-btn jk-btn-icon" data-jk-open-drawer="drawer-quick-recurso" title="Crear recurso" aria-label="Crear recurso">
                <i class="bi bi-plus-lg"></i>
            </button>
        </div>
        <small class="jk-help-text">El recurso es la persona, sala o equipamiento que realizara el servicio.</small>
        @Html.ValidationMessageFor(m => m.RecursoId, "", new { @class = "jk-field-error" })
    </div>

    <div class="jk-form-group">
        <label class="jk-label" for="@Html.IdFor(m => m.EstadoTurnoId)">@Html.DisplayNameFor(m => m.EstadoTurnoId)</label>
        @Html.DropDownListFor(m => m.EstadoTurnoId, Model.EstadosTurno, "Seleccione un estado", new { @class = "jk-input" })
        @Html.ValidationMessageFor(m => m.EstadoTurnoId, "", new { @class = "jk-field-error" })
    </div>

    <div class="jk-form-group">
        <label class="jk-label" for="@Html.IdFor(m => m.FechaHoraInicio)">@Html.DisplayNameFor(m => m.FechaHoraInicio)</label>
        <input type="datetime-local" class="jk-input" id="FechaHoraInicio" name="FechaHoraInicio"
               value="@(Model.FechaHoraInicio != DateTime.MinValue ? Model.FechaHoraInicio.ToString("yyyy-MM-ddTHH:mm") : "")" />
        @Html.ValidationMessageFor(m => m.FechaHoraInicio, "", new { @class = "jk-field-error" })
    </div>

    <div class="jk-form-group">
        <label class="jk-label" for="@Html.IdFor(m => m.Observaciones)">@Html.DisplayNameFor(m => m.Observaciones)</label>
        @Html.TextAreaFor(m => m.Observaciones, new { @class = "jk-input", placeholder = "Notas adicionales" })
        @Html.ValidationMessageFor(m => m.Observaciones, "", new { @class = "jk-field-error" })
    </div>
}

@{
    ViewBag.Title = "Editar Turno";
    ViewBag.Subtitle = "Modifica los datos del turno";
    ViewBag.SubmitText = "Guardar Cambios";
    ViewBag.CancelUrl = Url.Action("Index");

    ViewBag.FormContent = FormContent();
}

@Html.Partial("~/Views/Shared/Components/_FormLayout.cshtml")

@Html.Partial("~/Views/Shared/Components/_ServiceQuickCreateDrawer.cshtml",
    new ViewDataDictionary {
        { "DrawerId", "drawer-quick-servicio" },
        { "SelectId", "ServicioId" },
        { "ToastMessage", "Servicio creado correctamente" }
    })

@Html.Partial("~/Views/Shared/Components/_RecursoQuickCreateDrawer.cshtml",
    new ViewDataDictionary {
        { "DrawerId", "drawer-quick-recurso" },
        { "SelectId", "RecursoId" },
        { "ToastMessage", "Recurso creado correctamente" }
    })

@section scripts {
    <script>
        (function () {
            'use strict';

            function loadRecursos(servicioId) {
                var recursoDdl = document.getElementById('RecursoId');
                if (!recursoDdl) return;

                var url = servicioId
                    ? '@Url.Action("GetRecursosPorServicio", "Turnos")' + '?servicioId=' + servicioId
                    : '@Url.Action("GetRecursos", "Turnos")';

                recursoDdl.innerHTML = '<option value="">Cargando...</option>';

                fetch(url)
                    .then(function (response) { return response.json(); })
                    .then(function (data) {
                        recursoDdl.innerHTML = '<option value="">Seleccione un recurso</option>';
                        data.forEach(function (r) {
                            var option = document.createElement('option');
                            option.value = r.Id;
                            option.textContent = r.Nombre;
                            recursoDdl.appendChild(option);
                        });
                    });
            }

            var servicioDdl = document.getElementById('ServicioId');
            if (servicioDdl) {
                servicioDdl.addEventListener('change', function () {
                    loadRecursos(this.value);
                });
            }
        })();
    </script>
}