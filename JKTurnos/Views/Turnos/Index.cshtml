@model List<JKTurnos.Models.Entities.Turno>
@using JKTurnos.Models.Entities

@helper ListContent() {
    <div class="jk-hide-mobile">
        <div class="jk-table-wrap">
            <table class="jk-table">
                <thead>
                    <tr>
                        <th>Fecha/Hora</th>
                        <th>Cliente</th>
                        <th>Servicio</th>
                        <th>Recurso</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var codigo = item.EstadoTurno != null ? item.EstadoTurno.Codigo : null;
                        var turnoEliminado = !item.IsActive;
                        var puedeIniciar = !turnoEliminado && codigo == EstadosTurnoBase.Pendiente;
                        var puedeFinalizar = !turnoEliminado && codigo == EstadosTurnoBase.EnCurso;
                        var puedeCancelar = !turnoEliminado && (codigo == EstadosTurnoBase.Pendiente || codigo == EstadosTurnoBase.EnCurso);

                        <tr>
                            <td>@item.FechaHoraInicio.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@(item.Cliente != null ? item.Cliente.Nombre : "Sin cliente")</td>
                            <td>@(item.Servicio != null ? item.Servicio.Nombre : "Reservado")</td>
                            <td>@(item.Recurso != null ? item.Recurso.Nombre : "Sin recurso")</td>
                            <td>
                                <span class="jk-badge">@(item.EstadoTurno != null ? item.EstadoTurno.Nombre : "Sin estado")</span>
                                @if (turnoEliminado)
                                {
                                    <span class="jk-badge jk-badge-neutral">Eliminado</span>
                                }
                            </td>
                            <td>
                                <div class="jk-flex jk-gap-8 jk-flex-wrap">
                                    @if (puedeIniciar)
                                    {
                                        <button type="button" class="jk-btn jk-btn-sm jk-btn-soft-success" data-accion data-url="@Url.Action("IniciarAtencion", "Turnos")" data-turno="@item.Id" title="Iniciar atencion" aria-label="Iniciar atencion de @(item.Cliente != null ? item.Cliente.Nombre : "cliente")">
                                            <i class="bi bi-play-fill"></i>
                                        </button>
                                    }
                                    @if (puedeFinalizar)
                                    {
                                        <button type="button" class="jk-btn jk-btn-sm jk-btn-soft-success" data-accion data-url="@Url.Action("FinalizarAtencion", "Turnos")" data-turno="@item.Id" title="Finalizar atencion" aria-label="Finalizar atencion de @(item.Cliente != null ? item.Cliente.Nombre : "cliente")">
                                            <i class="bi bi-check-lg"></i>
                                        </button>
                                    }
                                    @if (puedeCancelar)
                                    {
                                        <button type="button" class="jk-btn jk-btn-sm jk-btn-soft-danger" data-accion data-url="@Url.Action("CancelarAtencion", "Turnos")" data-turno="@item.Id" title="Cancelar turno" aria-label="Cancelar turno de @(item.Cliente != null ? item.Cliente.Nombre : "cliente")">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    }
                                    <a class="jk-btn jk-btn-sm jk-btn-soft-warning" href="@Url.Action("Index", "Pagos", new { turnoId = item.Id })" title="Ver pagos" aria-label="Ver pagos">
                                        <i class="bi bi-cash-coin"></i>
                                    </a>
                                    <button type="button" class="jk-btn jk-btn-sm jk-btn-soft-info" data-ver-turno="@item.Id" title="Ver detalle" aria-label="Ver detalle del turno">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    @Html.Partial("~/Views/Shared/Components/_TableActions.cshtml",
                                        new ViewDataDictionary {
                                            { "EditUrl", Url.Action("Edit", new { id = item.Id }) },
                                            { "DeleteUrl", Url.Action("Delete", new { id = item.Id }) },
                                            { "ItemName", "Turno " + item.FechaHoraInicio.ToString("dd/MM") },
                                            { "Compact", false },
                                            { "ShowEdit", !turnoEliminado },
                                            { "ShowDelete", (ViewBag.EsAdmin ?? false) && !turnoEliminado }
                                        })
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="jk-show-mobile jk-flex jk-flex-col jk-gap-12">
        @foreach (var item in Model)
        {
            var codigo = item.EstadoTurno != null ? item.EstadoTurno.Codigo : null;
            var turnoEliminado = !item.IsActive;
            var puedeIniciar = !turnoEliminado && codigo == EstadosTurnoBase.Pendiente;
            var puedeFinalizar = !turnoEliminado && codigo == EstadosTurnoBase.EnCurso;
            var puedeCancelar = !turnoEliminado && (codigo == EstadosTurnoBase.Pendiente || codigo == EstadosTurnoBase.EnCurso);

            <div class="jk-card jk-card-compact">
                <div class="jk-flex-between">
                    <strong>
                        @(item.Cliente != null ? item.Cliente.Nombre : "Sin cliente")
                        @if (turnoEliminado)
                        {
                            <span class="jk-badge jk-badge-neutral">Eliminado</span>
                        }
                    </strong>
                    <div class="jk-flex jk-gap-4">
<a class="jk-btn jk-btn-sm jk-btn-soft-warning" href="@Url.Action("Index", "Pagos", new { turnoId = item.Id })" title="Ver pagos" aria-label="Ver pagos">
                                <i class="bi bi-cash-coin"></i>
                            </a>
                            <button type="button" class="jk-btn jk-btn-sm jk-btn-soft-info" data-ver-turno="@item.Id" title="Ver detalle" aria-label="Ver detalle del turno">
                                <i class="bi bi-eye"></i>
                            </button>
                            @Html.Partial("~/Views/Shared/Components/_TableActions.cshtml",
                            new ViewDataDictionary {
                                { "EditUrl", Url.Action("Edit", new { id = item.Id }) },
                                { "DeleteUrl", Url.Action("Delete", new { id = item.Id }) },
                                { "ItemName", "Turno " + item.FechaHoraInicio.ToString("dd/MM") },
                                { "Compact", true },
                                { "ShowEdit", !turnoEliminado },
                                { "ShowDelete", (ViewBag.EsAdmin ?? false) && !turnoEliminado }
                            })
                    </div>
                </div>
                <div class="jk-mt-8 jk-small">
                    <i class="bi bi-clock"></i> @item.FechaHoraInicio.ToString("dd/MM/yyyy HH:mm")
                </div>
                <div class="jk-small jk-mt-4">
                    <i class="bi bi-tag"></i> @(item.Servicio != null ? item.Servicio.Nombre : "Reservado")
                </div>
                <div class="jk-small jk-mt-4">
                    <i class="bi bi-person-badge"></i> @(item.Recurso != null ? item.Recurso.Nombre : "Sin recurso")
                </div>
                <div class="jk-mt-8">
                    <span class="jk-badge">@(item.EstadoTurno != null ? item.EstadoTurno.Nombre : "Sin estado")</span>
                </div>
                @if (puedeIniciar || puedeFinalizar || puedeCancelar)
                {
                    <div class="jk-flex jk-gap-8 jk-mt-8">
                        @if (puedeIniciar)
                        {
                            <button type="button" class="jk-btn jk-btn-sm jk-btn-soft-success" data-accion data-url="@Url.Action("IniciarAtencion", "Turnos")" data-turno="@item.Id">Iniciar</button>
                        }
                        @if (puedeFinalizar)
                        {
                            <button type="button" class="jk-btn jk-btn-sm jk-btn-soft-success" data-accion data-url="@Url.Action("FinalizarAtencion", "Turnos")" data-turno="@item.Id">Finalizar</button>
                        }
                        @if (puedeCancelar)
                        {
                            <button type="button" class="jk-btn jk-btn-sm jk-btn-soft-danger" data-accion data-url="@Url.Action("CancelarAtencion", "Turnos")" data-turno="@item.Id">Cancelar</button>
                        }
                    </div>
                }
            </div>
        }
    </div>
}

@helper EmptyContent() {
    bool hayFiltros = !string.IsNullOrWhiteSpace(ViewBag.Busqueda as string)
        || ViewBag.FechaInicio != null
        || ViewBag.FechaFin != null;

    string icon = "calendar";
    string title = "No tienes turnos hoy";
    string description = "Crea tu primer turno para comenzar a gestionar tu agenda.";
    string actionText = "Crear Turno";
    string actionUrl = Url.Action("Create");

    if (hayFiltros)
    {
        icon = "search";
        title = "Sin resultados";
        description = "No hay turnos que coincidan con la busqueda o el rango de fechas.";
        actionText = "Ver turnos de hoy";
        actionUrl = Url.Action("Index");
    }

    @Html.Partial("~/Views/Shared/Components/_EmptyState.cshtml",
        new ViewDataDictionary {
            { "Icon", icon },
            { "Title", title },
            { "Description", description },
            { "ActionText", actionText },
            { "ActionUrl", actionUrl }
        })
}

@helper FilterContent() {
    var todosEstados = ViewBag.Estados as JKTurnos.Models.Entities.EstadoTurnoBase[];
    var estadosElegidos = ViewBag.EstadosElegidos as List<string> ?? new List<string>();
    <form method="get" action="@Url.Action("Index")" class="jk-filter-bar">
        @Html.Partial("~/Views/Shared/Components/_SearchFilter.cshtml",
            new ViewDataDictionary {
                { "Name", "busqueda" },
                { "Id", "search-turnos" },
                { "Value", ViewBag.Busqueda },
                { "Placeholder", "Buscar por cliente, servicio o recurso..." }
            })

        @Html.Partial("~/Views/Shared/Components/_DateFilter.cshtml",
            new ViewDataDictionary {
                { "InicioName", "fechaInicio" },
                { "FinName", "fechaFin" },
                { "InicioValue", ViewBag.FechaInicio },
                { "FinValue", ViewBag.FechaFin },
                { "InicioLabel", "Desde" },
                { "FinLabel", "Hasta" }
            })

        <div class="jk-filter-group" title="Filtro por estado del turno">
            <span class="jk-filter-label"><i class="bi bi-funnel"></i> Estado</span>
            <div class="jk-checkbox-group">
            @if (todosEstados != null)
            {
                foreach (var est in todosEstados)
                {
                    var marcado = estadosElegidos.Contains(est.Codigo);
                    <label class="jk-checkbox-item">
                        <input type="checkbox" name="estados" value="@est.Codigo" @(marcado ? "checked" : "") />
                        <span class="jk-checkbox-swatch" style="background-color: @est.Color;"></span>
                        <span class="jk-checkbox-label">@est.Nombre</span>
                    </label>
                }
            }
            </div>
        </div>

        @if (ViewBag.EsAdmin == true)
        {
            var verEliminados = (bool)(ViewBag.IncluirEliminados ?? false);
            <div class="jk-filter-group" title="Mostrar los turnos eliminados">
                <span class="jk-filter-label"><i class="bi bi-eye-slash"></i> Incluir</span>
                <div class="jk-checkbox-group">
                    <label class="jk-checkbox-item">
                        <input type="checkbox" name="incluirEliminados" value="true" @(verEliminados ? "checked" : "") />
                        <span class="jk-checkbox-label">Eliminados</span>
                    </label>
                </div>
            </div>
        }

        <button type="submit" class="jk-btn jk-btn-primary">
            <i class="bi bi-search"></i> Buscar
        </button>

        <a href="@Url.Action("Index")" class="jk-btn jk-btn-primary">
            <i class="bi bi-arrow-counterclockwise"></i> Hoy
        </a>
    </form>
}

@{
    ViewBag.Title = "Turnos";
    ViewBag.Subtitle = "Administra tus turnos";
    ViewBag.PrimaryAction = Url.Action("Create");
    ViewBag.PrimaryActionLabel = "Nuevo Turno";
    ViewBag.ToolbarContent = FilterContent();

    ViewBag.PageContent = Model.Any() ? ListContent() : EmptyContent();
}

@Html.AntiForgeryToken()

@Html.Partial("~/Views/Shared/Components/_CrudPage.cshtml")

@Html.Partial("~/Views/Shared/Components/_Toast.cshtml", new ViewDataDictionary { { "Id", "jk-toast-turnos" } })

<div class="jk-drawer-backdrop" id="drawer-turno-local-backdrop"></div>
<div class="jk-drawer" id="drawer-turno-local" role="dialog" aria-modal="true" aria-hidden="true" aria-labelledby="drawer-turno-local-title"
     data-turno-detail-url="@Url.Action("GetDetailDrawer", "Turnos")"
     data-registrar-pago-url="@Url.Action("RegistrarPago", "Turnos")"
     data-toast-id="jk-toast-turnos">
    <div class="jk-drawer-header">
        <h3 class="jk-drawer-title" id="drawer-turno-local-title">Detalle del turno</h3>
        <button type="button" class="jk-drawer-close" id="drawer-turno-local-close" aria-label="Cerrar">
            <i class="bi bi-x"></i>
        </button>
    </div>
    <div class="jk-drawer-body" id="drawer-turno-local-body"></div>
</div>

@section scripts {
    <script>
        (function () {
            'use strict';

            function showToast(message, type) {
                var container = document.getElementById('jk-toast-turnos');
                if (!container) return;
                var toast = document.createElement('div');
                toast.className = 'jk-toast jk-toast-' + type;
                var icon = document.createElement('i');
                icon.className = 'bi bi-' + (type === 'success' ? 'check-circle' : 'exclamation-circle');
                toast.appendChild(icon);
                toast.appendChild(document.createTextNode(' ' + message));
                container.appendChild(toast);
                setTimeout(function () { toast.remove(); }, 4000);
            }

            // Acciones contextuales de cambio de estado (same pattern as Edit, P5):
            // fetch POST + anti-forgery + recarga. El timeblock cancelado deja de
            // mostrarse en la Agenda porque la grilla filtra cancelados (D-042).
            var estadoToken = document.querySelector('input[name="__RequestVerificationToken"]');

            document.querySelectorAll('[data-accion]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var accionUrl = btn.getAttribute('data-url');
                    var turnoId = btn.getAttribute('data-turno');
                    if (!estadoToken) return;

                    var body = '__RequestVerificationToken=' + encodeURIComponent(estadoToken.value) +
                               '&turnoId=' + encodeURIComponent(turnoId);

                    btn.disabled = true;

                    fetch(accionUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
                        body: body
                    })
                    .then(function (response) { return response.json(); })
                    .then(function (data) {
                        btn.disabled = false;
                        if (data.success) {
                            window.location.reload();
                        } else {
                            showToast(data.message || 'No se pudo realizar la accion', 'error');
                        }
                    })
                    .catch(function () {
                        btn.disabled = false;
                        showToast('Error de conexion al realizar la accion', 'error');
                    });
                });
            });
        })();
    </script>
}