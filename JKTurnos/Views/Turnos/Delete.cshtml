@model JKTurnos.Models.Entities.Turno

@{
    ViewBag.Title = "Eliminar Turno";
    ViewBag.Subtitle = "¿Estás seguro de que deseas eliminar este turno?";
    ViewBag.DeleteDescription = "Esta acción no se puede deshacer. Se eliminará el turno para el cliente " + Model.Cliente.Nombre + " en la fecha " + Model.FechaHoraInicio.ToString("dd/MM/yyyy HH:mm") + ".";
    ViewBag.FormAction = Url.Action("DeleteConfirmed", new { id = Model.Id });
    ViewBag.CancelUrl = Url.Action("Index");
}

@Html.Partial("~/Views/Shared/Components/_DeleteLayout.cshtml")
