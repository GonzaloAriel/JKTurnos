@helper FormContent() {
    <div class="jk-form-group">
        <label class="jk-label" for="passwordActual">Contraseña actual</label>
        <input type="password" class="jk-input" id="passwordActual" name="passwordActual" placeholder="Tu contraseña actual" />
        @Html.ValidationMessage("passwordActual", "", new { @class = "jk-field-error" })
    </div>

    <div class="jk-form-group">
        <label class="jk-label" for="nuevoPassword">Nueva contraseña</label>
        <input type="password" class="jk-input" id="nuevoPassword" name="nuevoPassword" placeholder="Nueva contraseña" />
        @Html.ValidationMessage("nuevoPassword", "", new { @class = "jk-field-error" })
    </div>

    <div class="jk-form-group">
        <label class="jk-label" for="confirmar">Confirmar contraseña</label>
        <input type="password" class="jk-input" id="confirmar" name="confirmar" placeholder="Repite la nueva contraseña" />
        @Html.ValidationMessage("confirmar", "", new { @class = "jk-field-error" })
    </div>
}

@{
    ViewBag.Title = "Cambiar Mi Contraseña";
    ViewBag.Subtitle = "Actualiza la contraseña de tu cuenta";
    ViewBag.SubmitText = "Guardar";
    ViewBag.CancelUrl = Url.Action("Index", "Home");
    ViewBag.FormContent = FormContent();
}

@Html.Partial("~/Views/Shared/Components/_FormLayout.cshtml")