@helper FormContent() {
    <div class="jk-form-group">
        <label class="jk-label" for="passwordActual">Contrasena actual</label>
        <input type="password" class="jk-input" id="passwordActual" name="passwordActual" placeholder="Tu contrasena actual" />
        @Html.ValidationMessage("passwordActual", "", new { @class = "jk-field-error" })
    </div>

    <div class="jk-form-group">
        <label class="jk-label" for="nuevoPassword">Nueva contrasena</label>
        <input type="password" class="jk-input" id="nuevoPassword" name="nuevoPassword" placeholder="Nueva contrasena" />
        @Html.ValidationMessage("nuevoPassword", "", new { @class = "jk-field-error" })
    </div>

    <div class="jk-form-group">
        <label class="jk-label" for="confirmar">Confirmar contrasena</label>
        <input type="password" class="jk-input" id="confirmar" name="confirmar" placeholder="Repite la nueva contrasena" />
        @Html.ValidationMessage("confirmar", "", new { @class = "jk-field-error" })
    </div>
}

@{
    ViewBag.Title = "Cambiar Mi Contrasena";
    ViewBag.Subtitle = "Actualiza la contrasena de tu cuenta";
    ViewBag.SubmitText = "Guardar";
    ViewBag.CancelUrl = Url.Action("Index", "Home");
    ViewBag.FormContent = FormContent();
}

@Html.Partial("~/Views/Shared/Components/_FormLayout.cshtml")