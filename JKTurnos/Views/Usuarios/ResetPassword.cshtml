@model JKTurnos.Models.Entities.User

@helper FormContent() {
    @Html.Hidden("id", Model.Id)

    <div class="jk-form-group">
        <label class="jk-label">Usuario</label>
        <input type="text" class="jk-input" value="@Model.Nombre (@Model.Email)" disabled />
    </div>

    <div class="jk-form-group">
        <label class="jk-label" for="password">Nuevo password</label>
        <input type="password" class="jk-input" id="password" name="password" placeholder="Nueva contrasena" />
        @Html.ValidationMessage("password", "", new { @class = "jk-field-error" })
    </div>

    <div class="jk-form-group">
        <label class="jk-label" for="confirmar">Confirmar password</label>
        <input type="password" class="jk-input" id="confirmar" name="confirmar" placeholder="Repite la nueva contrasena" />
        @Html.ValidationMessage("confirmar", "", new { @class = "jk-field-error" })
    </div>
}

@{
    ViewBag.Title = "Resetear Contrasena";
    ViewBag.Subtitle = "Define una nueva contrasena para el usuario";
    ViewBag.SubmitText = "Guardar";
    ViewBag.CancelUrl = Url.Action("Index");
    ViewBag.FormContent = FormContent();
}

@Html.Partial("~/Views/Shared/Components/_FormLayout.cshtml")