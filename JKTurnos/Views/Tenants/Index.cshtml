@model List<JKTurnos.Models.Entities.Tenant>

@helper ListContent() {
    <div class="jk-hide-mobile">
        <div class="jk-table-wrap">
            <table class="jk-table">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Subdominio</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Nombre</td>
                            <td>@item.Subdominio</td>
                            <td>
                                @Html.Partial("~/Views/Shared/Components/_TableActions.cshtml",
                                    new ViewDataDictionary {
                                        { "EditUrl", Url.Action("Edit", new { id = item.Id }) },
                                        { "DeleteUrl", Url.Action("Delete", new { id = item.Id }) },
                                        { "ItemName", item.Nombre },
                                        { "Compact", false }
                                    })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="jk-show-mobile jk-flex jk-flex-col jk-gap-12">
        @foreach (var item in Model)
        {
            <div class="jk-card jk-card-compact">
                <div class="jk-flex-between">
                    <strong>@item.Nombre</strong>
                    @Html.Partial("~/Views/Shared/Components/_TableActions.cshtml",
                        new ViewDataDictionary {
                            { "EditUrl", Url.Action("Edit", new { id = item.Id }) },
                            { "DeleteUrl", Url.Action("Delete", new { id = item.Id }) },
                            { "ItemName", item.Nombre },
                            { "Compact", true }
                        })
                </div>
                <div class="jk-mt-8 jk-small">
                    <i class="bi bi-globe"></i> @item.Subdominio
                </div>
            </div>
        }
    </div>
}

@helper EmptyContent() {
    @Html.Partial("~/Views/Shared/Components/_EmptyState.cshtml",
        new ViewDataDictionary {
            { "Icon", "building" },
            { "Title", "No tienes tenants" },
            { "Description", "Crea el primer tenant para comenzar a operar la plataforma." },
            { "ActionText", "Crear Tenant" },
            { "ActionUrl", Url.Action("Create") }
        })
}

@{
    ViewBag.Title = "Tenants";
    ViewBag.Subtitle = "Administra los negocios de la plataforma";
    ViewBag.PrimaryAction = Url.Action("Create");
    ViewBag.PrimaryActionLabel = "Nuevo Tenant";

    ViewBag.PageContent = Model.Any() ? ListContent() : EmptyContent();
}

@Html.Partial("~/Views/Shared/Components/_CrudPage.cshtml")