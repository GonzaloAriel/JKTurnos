@model JKTurnos.Models.ViewModels.PanelTenantsViewModel

@helper ListContent() {
    <!-- ===== RESUMEN (AG-7: shell Admin Global) ===== -->
    <div class="jk-card jk-mb-24">
        <div class="jk-grid">
            @Html.Partial("~/Views/Shared/Components/_KpiCard.cshtml",
                new ViewDataDictionary {
                    { "Label", "Activos" },
                    { "Value", Model.TotalActivos.ToString() }
                })
            @Html.Partial("~/Views/Shared/Components/_KpiCard.cshtml",
                new ViewDataDictionary {
                    { "Label", "Por vencer (7 dias)" },
                    { "Value", Model.TotalPorVencer.ToString() }
                })
            @Html.Partial("~/Views/Shared/Components/_KpiCard.cshtml",
                new ViewDataDictionary {
                    { "Label", "En gracia" },
                    { "Value", Model.TotalEnGracia.ToString() }
                })
            @Html.Partial("~/Views/Shared/Components/_KpiCard.cshtml",
                new ViewDataDictionary {
                    { "Label", "Vencidos" },
                    { "Value", Model.TotalVencidos.ToString() }
                })
            @Html.Partial("~/Views/Shared/Components/_KpiCard.cshtml",
                new ViewDataDictionary {
                    { "Label", "Suspendidos" },
                    { "Value", Model.TotalSuspendidos.ToString() }
                })
            @Html.Partial("~/Views/Shared/Components/_KpiCard.cshtml",
                new ViewDataDictionary {
                    { "Label", "Sin plan" },
                    { "Value", Model.TotalSinPlan.ToString() }
                })
        </div>
    </div>

    <div class="jk-hide-mobile">
        <div class="jk-table-wrap">
            <table class="jk-table">
                <thead>
                    <tr>
                        <th>Tenant</th>
                        <th>Estado</th>
                        <th>Plan</th>
                        <th>Vencimiento</th>
                        <th>Tiempo restante</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Tenants)
                    {
                        <tr>
                            <td>
                                <strong>@item.Nombre</strong><br />
                                <span class="jk-small text-secondary"><i class="bi bi-globe"></i> @item.Subdominio</span>
                            </td>
                            <td>
                                @Html.Partial("~/Views/Shared/Components/_BadgeEstadoSuscripcion.cshtml", item.Estado)
                            </td>
                            <td>@(item.PlanNombre ?? "-")</td>
                            <td>@(item.FechaVencimiento.HasValue ? item.FechaVencimiento.Value.ToString("dd/MM/yyyy") : "-")</td>
                            <td>@item.TiempoRestanteTexto</td>
                            <td>
                                <span class="jk-flex jk-gap-8">
                                    <a href="@Url.Action("Registrar", "PagosSuscripcion", new { tenantId = item.TenantId })" class="jk-btn jk-btn-icon" title="Registrar pago">
                                        <i class="bi bi-cash-stack"></i>
                                    </a>
                                    @using (Html.BeginForm(item.SuspendidoManual ? "Activar" : "Desactivar", "Tenants", new { id = item.TenantId }, FormMethod.Post, new { onsubmit = "return confirm('¿" + (item.SuspendidoManual ? "Activar" : "Desactivar") + " el tenant " + item.Nombre + "?');" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="jk-btn jk-btn-icon" title="@(item.SuspendidoManual ? "Activar" : "Desactivar")">
                                            <i class="bi bi-@(item.SuspendidoManual ? "play-circle" : "pause-circle")"></i>
                                        </button>
                                    }
                                    @Html.Partial("~/Views/Shared/Components/_TableActions.cshtml",
                                        new ViewDataDictionary {
                                            { "EditUrl", Url.Action("Edit", new { id = item.TenantId }) },
                                            { "DeleteUrl", Url.Action("Delete", new { id = item.TenantId }) },
                                            { "ItemName", item.Nombre },
                                            { "Compact", true }
                                        })
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="jk-show-mobile jk-flex jk-flex-col jk-gap-12">
        @foreach (var item in Model.Tenants)
        {
            <div class="jk-card jk-card-compact">
                <div class="jk-flex-between">
                    <strong>@item.Nombre</strong>
                    @Html.Partial("~/Views/Shared/Components/_BadgeEstadoSuscripcion.cshtml", item.Estado)
                </div>
                <div class="jk-mt-8 jk-small">
                    <i class="bi bi-globe"></i> @item.Subdominio ·
                    Plan: @(item.PlanNombre ?? "-")<br />
                    Vence: @(item.FechaVencimiento.HasValue ? item.FechaVencimiento.Value.ToString("dd/MM/yyyy") : "-") ·
                    @item.TiempoRestanteTexto
                </div>
                <div class="jk-mt-8 jk-flex jk-gap-8">
                    <a href="@Url.Action("Registrar", "PagosSuscripcion", new { tenantId = item.TenantId })" class="jk-btn jk-btn-sm jk-btn-ghost"><i class="bi bi-cash-stack"></i> Pago</a>
                    @using (Html.BeginForm(item.SuspendidoManual ? "Activar" : "Desactivar", "Tenants", new { id = item.TenantId }, FormMethod.Post, new { onsubmit = "return confirm('¿" + (item.SuspendidoManual ? "Activar" : "Desactivar") + " el tenant " + item.Nombre + "?');" }))
                    {
                        @Html.AntiForgeryToken()
                        if (item.SuspendidoManual)
                        {
                            <button type="submit" class="jk-btn jk-btn-sm jk-btn-primary"><i class="bi bi-play-circle"></i> Activar</button>
                        }
                        else
                        {
                            <button type="submit" class="jk-btn jk-btn-sm jk-btn-danger"><i class="bi bi-pause-circle"></i> Desactivar</button>
                        }
                    }
                    <a href="@Url.Action("Edit", new { id = item.TenantId })" class="jk-btn jk-btn-sm jk-btn-ghost"><i class="bi bi-pencil"></i> Editar</a>
                </div>
            </div>
        }
    </div>
}

@helper EmptyContent() {
    @Html.Partial("~/Views/Shared/Components/_EmptyState.cshtml",
        new ViewDataDictionary {
            { "Icon", "building" },
            { "Title", "No tienes tenants" },
            { "Description", "Crea el primer tenant para comenzar a operar la plataforma." },
            { "ActionText", "Crear Tenant" },
            { "ActionUrl", Url.Action("Create") }
        })
}

@{
    ViewBag.Title = "Tenants";
    ViewBag.Subtitle = "Administra los negocios de la plataforma";
    ViewBag.PrimaryAction = Url.Action("Create");
    ViewBag.PrimaryActionLabel = "Nuevo Tenant";

    ViewBag.PageContent = Model.Tenants.Any() ? ListContent() : EmptyContent();
}

@Html.Partial("~/Views/Shared/Components/_CrudPage.cshtml")

