@model JKTurnos.Models.Entities.Tenant

@{
    ViewBag.Title = "Desactivar Tenant";
    ViewBag.Subtitle = "Dar de baja el negocio";
}

@Html.Partial("~/Views/Shared/Components/_PageHeader.cshtml")

<div class="jk-card jk-mt-24">
    <p>¿Desea desactivar el tenant <strong>@Model.Nombre</strong> (<span>@Model.Subdominio</span>)?</p>
    <p class="jk-small text-secondary">Se desactivara el negocio y sus usuarios no podran acceder hasta que se reactive.</p>

    @using (Html.BeginForm("DesactivarConfirmado", "Tenants", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id)

        <div class="jk-flex jk-gap-12 jk-mt-16">
            <button type="submit" class="jk-btn jk-btn-danger">
                <i class="bi bi-pause-circle"></i> Si, desactivar
            </button>
            <a href="@Url.Action("Index")" class="jk-btn jk-btn-ghost">
                Cancelar
            </a>
        </div>
    }
</div>
