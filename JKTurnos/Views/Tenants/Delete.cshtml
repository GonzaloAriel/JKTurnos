@model JKTurnos.Models.Entities.Tenant

@{
    ViewBag.Title = "Eliminar Tenant";
    ViewBag.Subtitle = "Confirma la baja del negocio";
}

@Html.Partial("~/Views/Shared/Components/_PageHeader.cshtml")

<div class="jk-card jk-mt-24">
    <p>¿Estas seguro que deseas eliminar el tenant <strong>@Model.Nombre</strong> (<span>@Model.Subdominio</span>)?</p>

    @using (Html.BeginForm("DeleteConfirmed", "Tenants", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id)

        <div class="jk-flex jk-gap-12 jk-mt-16">
            <button type="submit" class="jk-btn jk-btn-danger">
                <i class="bi bi-trash"></i> Si, eliminar
            </button>
            <a href="@Url.Action("Index")" class="jk-btn jk-btn-ghost">
                Cancelar
            </a>
        </div>
    }
</div>