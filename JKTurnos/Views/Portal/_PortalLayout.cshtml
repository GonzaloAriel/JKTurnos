<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>@(ViewBag.PortalTitle ?? "Reservá tu turno") - @(ViewBag.PortalNegocio ?? "JKTurnos")</title>

    <!-- Fonts & Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- JK Design System v2 -->
    <link href="~/Content/DesignSystem/jk-tokens.css" rel="stylesheet" />
    <link href="~/Content/DesignSystem/jk-base.css" rel="stylesheet" />
    <link href="~/Content/DesignSystem/jk-components.css" rel="stylesheet" />
    <link href="~/Content/DesignSystem/jk-utilities.css" rel="stylesheet" />

    <!-- Portal -->
    <link href="~/Content/Pages/jk-portal.css" rel="stylesheet" />

    @if (IsSectionDefined("PageStyles"))
    {
        @RenderSection("PageStyles", required: false)
    }
</head>
<body class="jk-portal">
    <div class="jk-portal-shell">
        <div class="jk-portal-header">
            @if (!string.IsNullOrWhiteSpace(ViewBag.PortalLogo))
            {
                <img src="@ViewBag.PortalLogo" alt="Logo" class="jk-portal-logo" />
            }
            else
            {
                <i class="bi bi-calendar-check jk-portal-logo-icon"></i>
            }
            <span class="jk-portal-negocio">@(ViewBag.PortalNegocio ?? "JKTurnos")</span>
        </div>

        <main class="jk-portal-main">
            @RenderBody()
        </main>

        <footer class="jk-portal-footer">
            Turnos online via JKTurnos &middot; Confirmá tu reserva por WhatsApp
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @RenderSection("scripts", required: false)
</body>
</html>