@model JKTurnos.Models.ViewModels.PortalViewModel

@{
    ViewBag.Title = "Elegí tu turno";
    Layout = "~/Views/Portal/_PortalLayout.cshtml";
    ViewBag.PortalNegocio = Model.NegocioNombre;
    ViewBag.PortalLogo = Model.NegocioLogo;
}

<div class="jk-portal-card">
    <h1 class="jk-portal-step-title">Elegí un servicio</h1>
    <p class="jk-portal-step-sub">Selecciona qué recurso querés reservar para continuar.</p>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="jk-form-error">
            @Html.ValidationSummary(true)
        </div>
    }

    @using (Html.BeginForm("ElegirRecurso", "Portal", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(x => x.TenantId)

        if (Model.Recursos.Any())
        {
            foreach (var r in Model.Recursos)
            {
                <label class="jk-portal-recurso-card">
                    <input type="radio" name="RecursoId" value="@r.Id"
                        @((Model.RecursoId ?? 0) == r.Id ? "checked" : "") />
                    <span>
                        <strong>@r.Nombre</strong>
                        <br>
                        <small>@(r.Descripcion ?? string.Empty)</small>
                    </span>
                </label>
            }
        }
        else
        {
            <p class="jk-portal-step-sub">Este negocio aún no tiene recursos disponibles para reservar.</p>
        }

        <button type="submit" class="jk-btn jk-btn-primary"
            @(Model.Recursos.Any() ? "" : "disabled")>
            Continuar
        </button>
    }
</div>