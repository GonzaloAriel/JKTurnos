@model JKTurnos.Models.ViewModels.PortalViewModel

@{
    ViewBag.Title = "Fecha y hora";
    Layout = "~/Views/Portal/_PortalLayout.cshtml";
    ViewBag.PortalNegocio = Model.NegocioNombre;
    ViewBag.PortalLogo = Model.NegocioLogo;
}

<div class="jk-portal-card">
    <h1 class="jk-portal-step-title">Elegí fecha y hora</h1>
    <p class="jk-portal-step-sub">Primero elegí el día, luego la hora libre que te convenga.</p>

    <div class="jk-portal-date">
        @using (Html.BeginForm("Slots", "Portal", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(x => x.TenantId)
            @Html.HiddenFor(x => x.RecursoId)
            @Html.HiddenFor(x => x.Nombre)
            @Html.HiddenFor(x => x.Telefono)
            @Html.HiddenFor(x => x.Email)
            @Html.HiddenFor(x => x.Observaciones)

            <label class="jk-label" for="Fecha">Día</label>
            @Html.TextBoxFor(x => x.Fecha, new { @class = "jk-input", type = "date" })
            <button type="submit" class="jk-btn jk-btn-primary">Ver horarios</button>
        }
    </div>

    @if (Model.SlotsLibres.Any())
    {
        <p class="jk-portal-step-sub">Horarios disponibles para @Model.FechaLegible:</p>

        using (Html.BeginForm("ElegirHora", "Portal", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(x => x.TenantId)
            @Html.HiddenFor(x => x.RecursoId)
            @Html.HiddenFor(x => x.Fecha)
            @Html.HiddenFor(x => x.Nombre)
            @Html.HiddenFor(x => x.Telefono)
            @Html.HiddenFor(x => x.Email)
            @Html.HiddenFor(x => x.Observaciones)

            foreach (var slot in Model.SlotsLibres)
            {
                <button type="submit" name="HoraSeleccionada" value="@slot" class="jk-portal-slot">
                    @slot
                </button>
            }
        }
    }
    else if (Model.SlotsConsultados)
    {
        <p class="jk-portal-step-sub">
            No hay horarios libres para @Model.FechaLegible. Elegí otro día.
        </p>
    }
    else
    {
        <p class="jk-portal-step-sub">
            Elegí un día y pulsá "Ver horarios" para ver los horarios disponibles.
        </p>
    }

    <p class="jk-portal-otra">
        <a href="@Url.Action("Inicio", "Portal")" class="jk-btn jk-btn-secondary">Cambiar servicio</a>
    </p>
</div>