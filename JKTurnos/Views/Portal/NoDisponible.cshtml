@model JKTurnos.Controllers.PortalController.TenantContext

@{
    ViewBag.Title = "No disponible";
    Layout = "~/Views/Portal/_PortalLayout.cshtml";
    ViewBag.PortalNegocio = "JKTurnos";
}

<div class="jk-portal-card">
    @if (Model.NoExiste)
    {
        <h1 class="jk-portal-step-title">Este negocio no existe</h1>
        <p class="jk-portal-step-sub">
            No encontramos un negocio con este dominio. Comprobá la dirección e intentá de nuevo.
        </p>
    }
    else if (Model.NoHabilitado)
    {
        <h1 class="jk-portal-step-title">No disponible</h1>
        <p class="jk-portal-step-sub">
            Este negocio no habilita reservas online por ahora.
        </p>
    }

    <a href="https://jkturnos.com" class="jk-btn jk-btn-primary">
        Volver a JKTurnos
    </a>
</div>