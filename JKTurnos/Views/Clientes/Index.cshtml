@model List<JKTurnos.Models.Entities.Cliente>

@helper ListContent() {
    <div class="jk-hide-mobile">
        <div class="jk-table-wrap">
            <table class="jk-table">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Telefono</th>
                        <th class="jk-hide-tablet">Email</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var itemEliminado = !item.IsActive;

                        <tr>
                            <td>
                                @item.Nombre
                                @if (itemEliminado)
                                {
                                    <span class="jk-badge jk-badge-neutral">Eliminado</span>
                                }
                            </td>
                            <td>@item.Telefono</td>
                            <td class="jk-hide-tablet">@item.Email</td>
                            <td>
                                @Html.Partial("~/Views/Shared/Components/_TableActions.cshtml",
                                    new ViewDataDictionary {
                                        { "ViewUrl", Url.Action("Details", new { id = item.Id }) },
                                        { "ViewLabel", "Historial" },
                                        { "EditUrl", Url.Action("Edit", new { id = item.Id }) },
                                        { "DeleteUrl", Url.Action("Delete", new { id = item.Id }) },
                                        { "ItemName", item.Nombre },
                                        { "Compact", false },
                                        { "ShowEdit", !itemEliminado },
                                        { "ShowDelete", !User.IsInRole(JKTurnos.Models.Entities.Roles.User) && !itemEliminado },
                                        { "RestoreUrl", itemEliminado ? Url.Action("Restaurar", new { id = item.Id }) : null }
                                    })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="jk-show-mobile jk-flex jk-flex-col jk-gap-12">
        @foreach (var item in Model)
        {
            var itemEliminado = !item.IsActive;

            <div class="jk-card jk-card-compact">
                <div class="jk-flex-between">
                    <strong>
                        @item.Nombre
                        @if (itemEliminado)
                        {
                            <span class="jk-badge jk-badge-neutral">Eliminado</span>
                        }
                    </strong>
                    @Html.Partial("~/Views/Shared/Components/_TableActions.cshtml",
                        new ViewDataDictionary {
                            { "ViewUrl", Url.Action("Details", new { id = item.Id }) },
                            { "ViewLabel", "Historial" },
                            { "EditUrl", Url.Action("Edit", new { id = item.Id }) },
                            { "DeleteUrl", Url.Action("Delete", new { id = item.Id }) },
                            { "ItemName", item.Nombre },
                            { "Compact", true },
                            { "ShowEdit", !itemEliminado },
                            { "ShowDelete", !User.IsInRole(JKTurnos.Models.Entities.Roles.User) && !itemEliminado },
                            { "RestoreUrl", itemEliminado ? Url.Action("Restaurar", new { id = item.Id }) : null }
                        })
                </div>
                @if (!string.IsNullOrEmpty(item.Telefono))
                {
                    <div class="jk-mt-8 jk-small">
                        <i class="bi bi-telephone"></i> @item.Telefono
                    </div>
                }
                @if (!string.IsNullOrEmpty(item.Email))
                {
                    <div class="jk-small jk-mt-4">
                        <i class="bi bi-envelope"></i> @item.Email
                    </div>
                }
            </div>
        }
    </div>
}

@helper EmptyContent() {
    bool hayFiltros = !string.IsNullOrWhiteSpace(ViewBag.Busqueda as string);

    string icon = "people";
    string title = "No tienes clientes";
    string description = "Crea tu primer cliente para comenzar a gestionar tus turnos.";
    string actionText = "Crear Cliente";
    string actionUrl = Url.Action("Create");

    if (hayFiltros)
    {
        icon = "search";
        title = "Sin resultados";
        description = "No hay clientes que coincidan con la busqueda.";
        actionText = "Ver todos los clientes";
        actionUrl = Url.Action("Index");
    }

    @Html.Partial("~/Views/Shared/Components/_EmptyState.cshtml",
        new ViewDataDictionary {
            { "Icon", icon },
            { "Title", title },
            { "Description", description },
            { "ActionText", actionText },
            { "ActionUrl", actionUrl }
        })
}

@helper FilterContent() {
    <form method="get" action="@Url.Action("Index")" class="jk-filter-bar">
        @Html.Partial("~/Views/Shared/Components/_SearchFilter.cshtml",
            new ViewDataDictionary {
                { "Name", "busqueda" },
                { "Id", "search-clientes" },
                { "Value", ViewBag.Busqueda },
                { "Placeholder", "Buscar por nombre, telefono o email..." }
            })

        @if (ViewBag.EsAdmin == true)
        {
            var verEliminados = (bool)(ViewBag.IncluirEliminados ?? false);
            <div class="jk-filter-group" title="Mostrar los clientes dados de baja">
                <span class="jk-filter-label"><i class="bi bi-eye-slash"></i> Incluir</span>
                <div class="jk-checkbox-group">
                    <label class="jk-checkbox-item">
                        <input type="checkbox" name="incluirEliminados" value="true" @(verEliminados ? "checked" : "") />
                        <span class="jk-checkbox-label">Eliminados</span>
                    </label>
                </div>
            </div>
        }

        <button type="submit" class="jk-btn jk-btn-primary">
            <i class="bi bi-search"></i> Buscar
        </button>

        <a href="@Url.Action("Index")" class="jk-btn jk-btn-primary">
            <i class="bi bi-arrow-counterclockwise"></i> Limpiar
        </a>
    </form>
}

@{
    ViewBag.Title = "Clientes";
    ViewBag.Subtitle = "Administra tus clientes";
    ViewBag.PrimaryAction = Url.Action("Create");
    ViewBag.PrimaryActionLabel = "Nuevo Cliente";
    ViewBag.ToolbarContent = FilterContent();

    ViewBag.PageContent = Model.Any() ? ListContent() : EmptyContent();
}

@Html.Partial("~/Views/Shared/Components/_CrudPage.cshtml")
