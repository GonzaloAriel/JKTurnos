@model JKTurnos.Models.Entities.Cliente

@helper FormContent() {
    @Html.HiddenFor(m => m.Id)
    @Html.HiddenFor(m => m.CreatedAt)
    @Html.HiddenFor(m => m.TenantId)
    @Html.HiddenFor(m => m.IsActive)

    <div class="jk-form-group">
        <label class="jk-label" for="@Html.IdFor(m => m.Nombre)">@Html.DisplayNameFor(m => m.Nombre)</label>
        @Html.TextBoxFor(m => m.Nombre, new { @class = "jk-input", placeholder = "Nombre completo" })
        @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "jk-field-error" })
    </div>

    <div class="jk-form-group">
        <label class="jk-label" for="@Html.IdFor(m => m.Telefono)">@Html.DisplayNameFor(m => m.Telefono)</label>
        @Html.TextBoxFor(m => m.Telefono, new { @class = "jk-input", placeholder = "Telefono" })
        @Html.ValidationMessageFor(m => m.Telefono, "", new { @class = "jk-field-error" })
    </div>

    <div class="jk-form-group">
        <label class="jk-label" for="@Html.IdFor(m => m.Email)">@Html.DisplayNameFor(m => m.Email)</label>
        @Html.TextBoxFor(m => m.Email, new { @class = "jk-input", placeholder = "cliente@ejemplo.com" })
        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "jk-field-error" })
    </div>

    <div class="jk-form-group">
        <label class="jk-label" for="@Html.IdFor(m => m.Direccion)">@Html.DisplayNameFor(m => m.Direccion)</label>
        @Html.TextBoxFor(m => m.Direccion, new { @class = "jk-input", placeholder = "Direccion" })
        @Html.ValidationMessageFor(m => m.Direccion, "", new { @class = "jk-field-error" })
    </div>
}

@{
    ViewBag.Title = "Editar Cliente";
    ViewBag.Subtitle = "Actualiza los datos del cliente";
    ViewBag.SubmitText = "Actualizar";
    ViewBag.CancelUrl = Url.Action("Index");

    ViewBag.FormContent = FormContent();
}

@Html.Partial("~/Views/Shared/Components/_FormLayout.cshtml")
