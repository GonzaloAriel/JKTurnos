@model JKTurnos.Models.ViewModels.HomeViewModel
@using RolesConst = JKTurnos.Models.Entities.Roles;

@{
    ViewBag.Title = "Command Center";
    var hour = DateTime.Now.Hour;
    string greeting = "Buenos dias";

    if (hour >= 12 && hour < 20)
    {
        greeting = "Buenas tardes";
    }
    else if (hour >= 20 || hour < 5)
    {
        greeting = "Buenas noches";
    }

    var today = DateTime.Now;
    var dayNames = new string[] { "Dom", "Lun", "Mar", "Mie", "Jue", "Vie", "Sab" };
    var monthNames = new string[] { "Ene", "Feb", "Mar", "Abr", "May", "Jun", "Jul", "Ago", "Sep", "Oct", "Nov", "Dic" };
    string todayDate = dayNames[(int)today.DayOfWeek] + " " + today.Day + " " + monthNames[today.Month - 1];
}

<div class="fade-in">

    <!-- ===== 1. BIENVENIDA PERSONALIZADA ===== -->
    <div class="welcome-section">
        @if (!string.IsNullOrWhiteSpace(ViewBag.ConfiguracionLogo))
        {
            <div class="welcome-brand">
                <img src="@ViewBag.ConfiguracionLogo"
                     alt="Logo del negocio"
                     class="welcome-brand-logo" />
            </div>
        }
        <h1 class="contextual-greeting">@greeting, @User.Identity.Name.</h1>
        @if (Model.TurnosHoy > 0)
        {
            <p class="contextual-status">
                <i class="bi bi-calendar2-check welcome-icon"></i>
                Tienes @Model.TurnosHoy turno(s) hoy. Tu dia arranca a las @Model.TurnosDelDia.First().FechaHoraInicio.ToString("HH:mm").
            </p>
        }
        else
        {
            <p class="contextual-status">
                <i class="bi bi-sun welcome-icon"></i>
                No tienes turnos agendados para hoy. Tu agenda esta libre.
            </p>
        }
    </div>

    <!-- ===== 2. ACCIONES RAPIDAS ===== -->
    <div class="home-section">
        <div class="section-header">
            <h2 class="section-title">Acciones rapidas</h2>
        </div>
        <div class="quick-actions">
            <a href="@Url.Action("Create", "Turnos")" class="quick-action-link">
                <i class="bi bi-plus-circle"></i>
                Nuevo Turno
            </a>
            <a href="@Url.Action("Create", "Clientes")" class="quick-action-link">
                <i class="bi bi-person-plus"></i>
                Nuevo Cliente
            </a>
            <a href="@Url.Action("Agenda", "Turnos")" class="quick-action-link">
                <i class="bi bi-calendar3"></i>
                Ver Agenda
            </a>
            @if (User.IsInRole(RolesConst.Admin))
            {
                <a href="@Url.Action("Index", "Configuracion")" class="quick-action-link">
                    <i class="bi bi-gear"></i>
                    Configurar
                </a>
            }
        </div>
    </div>

    <!-- ===== 3. MI DIA ===== -->
    <div class="home-section">
        <div class="mi-dia">
            <div class="mi-dia-header">
                <h2 class="mi-dia-title"><i class="bi bi-sun mi-dia-title-icon" aria-hidden="true"></i>Mi dia</h2>
                <span class="mi-dia-date">@todayDate</span>
            </div>
            <div class="mi-dia-body">
                @if (Model.TurnosDelDia.Any())
                {
                    var gruposPorRecurso = Model.TurnosDelDia
                        .GroupBy(t => t.Recurso)
                        .OrderBy(g => g.Key != null ? g.Key.Nombre : "");

                    <div class="mi-dia-lanes">
                        @foreach (var grupo in gruposPorRecurso)
                        {
                            var recursoNombre = grupo.Key != null ? grupo.Key.Nombre : "Sin recurso";
                            var recursoColor = grupo.Key != null && !string.IsNullOrEmpty(grupo.Key.Color) ? grupo.Key.Color : "#2563eb";

                            <div class="mi-dia-lane" style="--jk-block-color: @recursoColor;">
                                <div class="mi-dia-lane-header">
                                    <span class="mi-dia-lane-dot" aria-hidden="true"></span>
                                    <span class="mi-dia-lane-name">@recursoNombre</span>
                                    <span class="mi-dia-lane-count">@grupo.Count()</span>
                                </div>
                                <div class="mi-dia-lane-row">
                                    @foreach (var t in grupo)
                                    {
                                        var clienteNombre = t.Cliente != null ? t.Cliente.Nombre : "Cliente";
                                        var estadoNombre = t.EstadoTurno != null ? t.EstadoTurno.Nombre : "";
                                        var estadoColor = t.EstadoTurno != null ? t.EstadoTurno.Color : "#aeaeb2";

                                        <a href="@Url.Action("Agenda", "Turnos")" class="mi-dia-chip" title="@estadoNombre" style="--jk-status-color: @estadoColor;">
                                            <span class="mi-dia-chip-status"><i class="bi bi-circle-fill"></i></span>
                                            <span class="mi-dia-chip-time">@t.FechaHoraInicio.ToString("HH:mm")</span>
                                            <span class="mi-dia-chip-client">@clienteNombre</span>
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="mi-dia-empty">
                        <div class="mi-dia-empty-icon">
                            <i class="bi bi-sun"></i>
                        </div>
                        <h3 class="mi-dia-empty-title">Tu agenda esta libre</h3>
                        <p class="mi-dia-empty-text">
                            No tienes turnos agendados para hoy.
                            Crea tu primer turno para comenzar.
                        </p>
                        <a href="@Url.Action("Create", "Turnos")" class="jk-btn jk-btn-primary">Crear mi primer turno</a>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ===== 4. RESUMEN DEL NEGOCIO / KPIs ===== -->
    <div class="home-section">
        <div class="section-header">
            <h2 class="section-title">Resumen del dia</h2>
        </div>
        <div class="kpi-row">
            <div class="kpi-item">
                <div class="kpi-label">Turnos Hoy</div>
                <div class="kpi-value">@Model.TurnosHoy</div>
            </div>
            <div class="kpi-item">
                <div class="kpi-label">Ingresos</div>
                <div class="kpi-value">$ @Model.IngresosHoy.ToString("N2")</div>
            </div>
            <div class="kpi-item">
                <div class="kpi-label">Ocupacion</div>
                <div class="kpi-value">@Model.Ocupacion%</div>
            </div>
            <div class="kpi-item">
                <div class="kpi-label">Clientes</div>
                <div class="kpi-value">@Model.Clientes</div>
            </div>
        </div>
    </div>

    <!-- ===== 5. ACCIONES SUGERIDAS ===== -->
    <div class="home-section">
        <div class="section-header">
            <h2 class="section-title">Acciones sugeridas</h2>
        </div>
        <p class="suggestion-intro">
            Ayudame a conocer mejor tu negocio para asistirte mejor.
        </p>

        <div class="suggestion-grid">
            <div class="suggestion-card">
                <div class="suggestion-icon suggestion-icon-blue">
                    <i class="bi bi-shop"></i>
                </div>
                <div class="suggestion-content">
                    <div class="suggestion-title">Completa tu negocio</div>
                    <div class="suggestion-desc">Configura logo, direccion y datos de contacto.</div>
                    <a href="#" class="suggestion-action">
                        Configurar <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>

            <div class="suggestion-card">
                <div class="suggestion-icon suggestion-icon-green">
                    <i class="bi bi-scissors"></i>
                </div>
                <div class="suggestion-content">
                    <div class="suggestion-title">Agrega servicios</div>
                    <div class="suggestion-desc">Define que ofreces y cuanto tiempo dura cada uno.</div>
                    <a href="@Url.Action("Create", "Servicios")" class="suggestion-action">
                        Agregar <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>

            <div class="suggestion-card">
                <div class="suggestion-icon suggestion-icon-amber">
                    <i class="bi bi-clock"></i>
                </div>
                <div class="suggestion-content">
                    <div class="suggestion-title">Configura horarios</div>
                    <div class="suggestion-desc">Define tus dias y horas de atencion.</div>
                    <a href="#" class="suggestion-action">
                        Definir <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== 6. ACTIVIDAD RECIENTE ===== -->
    <div class="home-section">
        <div class="section-header">
            <h2 class="section-title">Actividad reciente</h2>
        </div>

        <div class="activity-timeline jk-notif-scroll">
            @Html.Partial("~/Views/Shared/Components/_NotificacionesFeed.cshtml")
        </div>
    </div>

</div>